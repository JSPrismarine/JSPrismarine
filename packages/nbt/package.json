{
    "name": "@jsprismarine/nbt",
    "version": "0.26.0",
    "description": "NBT reader and writer for Minecraft: Bedrock Edition",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./tag": {
                "types": "./dist/tag.d.ts",
                "import": "./dist/tag.js",
                "module": "./dist/tag.js"
            },
            "./snbt": {
                "types": "./dist/snbt.d.ts",
                "import": "./dist/snbt.js",
                "module": "./dist/snbt.js"
            },
            "./path": {
                "types": "./dist/path.d.ts",
                "import": "./dist/path.js",
                "module": "./dist/path.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./tag": {
            "jsprismarine:dist": "./dist/tag.js",
            "default": "./src/tag.ts"
        },
        "./snbt": {
            "jsprismarine:dist": "./dist/snbt.js",
            "default": "./src/snbt.ts"
        },
        "./path": {
            "jsprismarine:dist": "./dist/path.js",
            "default": "./src/path.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "minecraft",
        "nbt",
        "bedrock"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/nbt",
    "devDependencies": {
        "@types/node": "26.6.7",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "dependencies": {
        "@jsprismarine/binaryutils": "workspace:*",
        "@jsprismarine/errors": "workspace:*"
    }
}
