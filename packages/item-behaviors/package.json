{
    "name": "@jsprismarine/item-behaviors",
    "version": "0.23.2",
    "description": "The vanilla item behavior families that fill the item hook seam, with Java's mining speed and attack damage formulas.",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./behaviors/combat": {
                "types": "./dist/behaviors/combat.d.ts",
                "import": "./dist/behaviors/combat.js",
                "module": "./dist/behaviors/combat.js"
            },
            "./behaviors/placement": {
                "types": "./dist/behaviors/placement.d.ts",
                "import": "./dist/behaviors/placement.js",
                "module": "./dist/behaviors/placement.js"
            },
            "./world": {
                "types": "./dist/world.d.ts",
                "import": "./dist/world.js",
                "module": "./dist/world.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./behaviors/combat": {
            "jsprismarine:dist": "./dist/behaviors/combat.js",
            "default": "./src/behaviors/combat.ts"
        },
        "./behaviors/placement": {
            "jsprismarine:dist": "./dist/behaviors/placement.js",
            "default": "./src/behaviors/placement.ts"
        },
        "./world": {
            "jsprismarine:dist": "./dist/world.js",
            "default": "./src/world.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "bedrock",
        "items",
        "behaviors"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/item-behaviors",
    "dependencies": {
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/items": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    }
}
