{
    "name": "@jsprismarine/bedrock-data",
    "version": "0.15.2",
    "description": "Minecraft Bedrock game data exported in a nodejs friendly way.",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.es.js",
                "module": "./dist/index.es.js",
                "require": "./dist/index.cjs.cjs"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.es.js",
                "module": "./dist/*.es.js",
                "require": "./dist/*.cjs.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "src/vendor",
        "CHANGELOG.md",
        "README.md"
    ],
    "main": "./dist/index.cjs.cjs",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "datagen:java": "node utils/java/datagen.ts",
        "dump:bedrock": "node utils/bedrock-dump/run.ts",
        "dump:java": "node utils/java-dump/run.mjs",
        "extract:structures": "node utils/java/extract-structures.ts",
        "ensure:java-server": "node utils/java-dump/ensure-server.ts",
        "ensure:worldgen": "node utils/java/ensure-worldgen.ts",
        "fetch:cloudburst": "node utils/fetch/fetch-cloudburst.ts",
        "fetch:sources": "node utils/fetch/fetch-sources.ts",
        "generate": "node utils/fetch/fetch-cloudburst.ts && node utils/build.js",
        "build": "pnpm run generate && vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "pnpm run build",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "bedrock-data"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/bedrock-data",
    "devDependencies": {
        "@jsprismarine/binaryutils": "workspace:*",
        "@jsprismarine/leveldb": "workspace:*",
        "@jsprismarine/nbt": "workspace:*",
        "@types/node": "24.19.2",
        "glob": "13.0.6",
        "rimraf": "6.1.3",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
