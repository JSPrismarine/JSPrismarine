{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "incremental": false,
        "inlineSourceMap": false,
        "paths": {
            // Keep subpath imports on dist declarations instead of mixing in their source graph:
            // a packet class from source is not the same type as the one `index.d.ts` names.
            "@jsprismarine/protocol/*": ["../protocol/dist/*"],
            "@jsprismarine/*": ["../*/dist/index.d.ts"]
        }
    },
    "include": ["src/**/*", "src/**/*.json"],
    "exclude": ["src/**/*.test.*", "src/**/*.test-utils.*"]
}
