{
    "name": "@jsprismarine/items",
    "version": "0.26.0",
    "description": "The item definition and component runtime: Java 26.3's 122 data component types over Bedrock item identities",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./ItemStack": {
                "types": "./dist/ItemStack.d.ts",
                "import": "./dist/ItemStack.js",
                "module": "./dist/ItemStack.js"
            },
            "./hooks": {
                "types": "./dist/hooks.d.ts",
                "import": "./dist/hooks.js",
                "module": "./dist/hooks.js"
            },
            "./tables": {
                "types": "./dist/tables.d.ts",
                "import": "./dist/tables.js",
                "module": "./dist/tables.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./ItemStack": {
            "jsprismarine:dist": "./dist/ItemStack.js",
            "default": "./src/ItemStack.ts"
        },
        "./hooks": {
            "jsprismarine:dist": "./dist/hooks.js",
            "default": "./src/hooks.ts"
        },
        "./tables": {
            "jsprismarine:dist": "./dist/tables.js",
            "default": "./src/tables.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "generate:item-types": "node utils/generate/generate-item-types.ts",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "bedrock",
        "items",
        "components"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/items",
    "dependencies": {
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/errors": "workspace:*"
    },
    "devDependencies": {
        "@jsprismarine/bedrock-data": "workspace:*",
        "@jsprismarine/mapping": "workspace:*",
        "@types/node": "26.6.11",
        "glob": "14.0.6",
        "prettier": "3.10.1",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.4.0",
        "vitest": "5.1.2"
    }
}
