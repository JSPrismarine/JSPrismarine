{
    "name": "@jsprismarine/brigadier",
    "version": "0.14.2",
    "description": "A javascript re-implementation of Mojang's Brigadier library",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.es.js",
                "module": "./dist/index.es.js",
                "require": "./dist/index.cjs.cjs"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.es.js",
                "module": "./dist/*.es.js",
                "require": "./dist/*.cjs.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "LICENSE",
        "CHANGELOG.md",
        "README.md"
    ],
    "main": "./dist/index.cjs.cjs",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "typecheck": "tsc-ts --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "nodejs",
        "brigadier",
        "minecraft",
        "minecraft-commands",
        "commands"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/brigadier",
    "devDependencies": {
        "@types/node": "24.13.6",
        "glob": "13.0.6",
        "rimraf": "6.1.3",
        "typescript": "7.0.2",
        "vite": "8.3.3",
        "vitest": "5.0.1"
    }
}
