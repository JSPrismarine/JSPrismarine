{
    "name": "@jsprismarine/script-host",
    "version": "0.21.0",
    "private": true,
    "description": "Runs Bedrock behavior pack scripts for JSPrismarine in an embedded QuickJS, bound through node:ffi",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/ScriptEngine.d.ts",
                "import": "./dist/ScriptEngine.js",
                "module": "./dist/ScriptEngine.js"
            },
            "./errors": {
                "types": "./dist/errors.d.ts",
                "import": "./dist/errors.js",
                "module": "./dist/errors.js"
            },
            "./values": {
                "types": "./dist/values.d.ts",
                "import": "./dist/values.js",
                "module": "./dist/values.js"
            },
            "./library": {
                "types": "./dist/library.d.ts",
                "import": "./dist/library.js",
                "module": "./dist/library.js"
            },
            "./absentGlobals": {
                "types": "./dist/absentGlobals.d.ts",
                "import": "./dist/absentGlobals.js",
                "module": "./dist/absentGlobals.js"
            },
            "./shape/binding": {
                "types": "./dist/shape/binding.d.ts",
                "import": "./dist/shape/binding.js",
                "module": "./dist/shape/binding.js"
            },
            "./shape/implementations": {
                "types": "./dist/shape/implementations.d.ts",
                "import": "./dist/shape/implementations.js",
                "module": "./dist/shape/implementations.js"
            },
            "./shape/resolve": {
                "types": "./dist/shape/resolve.d.ts",
                "import": "./dist/shape/resolve.js",
                "module": "./dist/shape/resolve.js"
            },
            "./shape/history": {
                "types": "./dist/shape/history.d.ts",
                "import": "./dist/shape/history.js",
                "module": "./dist/shape/history.js"
            },
            "./shape/format": {
                "types": "./dist/shape/format.d.ts",
                "import": "./dist/shape/format.js",
                "module": "./dist/shape/format.js"
            },
            "./debugger/EngineDebugger": {
                "types": "./dist/debugger/EngineDebugger.d.ts",
                "import": "./dist/debugger/EngineDebugger.js",
                "module": "./dist/debugger/EngineDebugger.js"
            },
            "./debugger/DebugSession": {
                "types": "./dist/debugger/DebugSession.d.ts",
                "import": "./dist/debugger/DebugSession.js",
                "module": "./dist/debugger/DebugSession.js"
            },
            "./debugger/protocol": {
                "types": "./dist/debugger/protocol.d.ts",
                "import": "./dist/debugger/protocol.js",
                "module": "./dist/debugger/protocol.js"
            },
            "./debugger/framing": {
                "types": "./dist/debugger/framing.d.ts",
                "import": "./dist/debugger/framing.js",
                "module": "./dist/debugger/framing.js"
            },
            "./debugger/transport": {
                "types": "./dist/debugger/transport.d.ts",
                "import": "./dist/debugger/transport.js",
                "module": "./dist/debugger/transport.js"
            },
            "./debugger/channel": {
                "types": "./dist/debugger/channel.d.ts",
                "import": "./dist/debugger/channel.js",
                "module": "./dist/debugger/channel.js"
            },
            "./host/WorldScripts": {
                "types": "./dist/host/WorldScripts.d.ts",
                "import": "./dist/host/WorldScripts.js",
                "module": "./dist/host/WorldScripts.js"
            },
            "./host/world": {
                "types": "./dist/host/world.d.ts",
                "import": "./dist/host/world.js",
                "module": "./dist/host/world.js"
            },
            "./host/pack": {
                "types": "./dist/host/pack.d.ts",
                "import": "./dist/host/pack.js",
                "module": "./dist/host/pack.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/ScriptEngine.js",
    "types": "./dist/ScriptEngine.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/ScriptEngine.js",
            "default": "./src/ScriptEngine.ts"
        },
        "./errors": {
            "jsprismarine:dist": "./dist/errors.js",
            "default": "./src/errors.ts"
        },
        "./values": {
            "jsprismarine:dist": "./dist/values.js",
            "default": "./src/values.ts"
        },
        "./library": {
            "jsprismarine:dist": "./dist/library.js",
            "default": "./src/library.ts"
        },
        "./absentGlobals": {
            "jsprismarine:dist": "./dist/absentGlobals.js",
            "default": "./src/absentGlobals.ts"
        },
        "./shape/binding": {
            "jsprismarine:dist": "./dist/shape/binding.js",
            "default": "./src/shape/binding.ts"
        },
        "./shape/implementations": {
            "jsprismarine:dist": "./dist/shape/implementations.js",
            "default": "./src/shape/implementations.ts"
        },
        "./shape/resolve": {
            "jsprismarine:dist": "./dist/shape/resolve.js",
            "default": "./src/shape/resolve.ts"
        },
        "./shape/history": {
            "jsprismarine:dist": "./dist/shape/history.js",
            "default": "./src/shape/history.ts"
        },
        "./shape/format": {
            "jsprismarine:dist": "./dist/shape/format.js",
            "default": "./src/shape/format.ts"
        },
        "./debugger/EngineDebugger": {
            "jsprismarine:dist": "./dist/debugger/EngineDebugger.js",
            "default": "./src/debugger/EngineDebugger.ts"
        },
        "./debugger/DebugSession": {
            "jsprismarine:dist": "./dist/debugger/DebugSession.js",
            "default": "./src/debugger/DebugSession.ts"
        },
        "./debugger/protocol": {
            "jsprismarine:dist": "./dist/debugger/protocol.js",
            "default": "./src/debugger/protocol.ts"
        },
        "./debugger/framing": {
            "jsprismarine:dist": "./dist/debugger/framing.js",
            "default": "./src/debugger/framing.ts"
        },
        "./debugger/transport": {
            "jsprismarine:dist": "./dist/debugger/transport.js",
            "default": "./src/debugger/transport.ts"
        },
        "./debugger/channel": {
            "jsprismarine:dist": "./dist/debugger/channel.js",
            "default": "./src/debugger/channel.ts"
        },
        "./host/WorldScripts": {
            "jsprismarine:dist": "./dist/host/WorldScripts.js",
            "default": "./src/host/WorldScripts.ts"
        },
        "./host/world": {
            "jsprismarine:dist": "./dist/host/world.js",
            "default": "./src/host/world.ts"
        },
        "./host/pack": {
            "jsprismarine:dist": "./dist/host/pack.js",
            "default": "./src/host/pack.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "build:native": "node scripts/build-native.mts",
        "generate:shape": "node scripts/generate-shape.mts",
        "check:shape": "node scripts/generate-shape.mts --check",
        "count:corpus": "node scripts/count-corpus.mts",
        "check:corpus": "node scripts/count-corpus.mts --check",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "nodejs",
        "minecraft",
        "bedrock",
        "scripting",
        "quickjs"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/script-host",
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "rolldown": "1.3.2",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.0"
    }
}
