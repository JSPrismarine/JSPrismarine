+/* JSPrismarine: the line of a bytecode position, from a table built on
+   first use; 0 for the function's prologue, before its first statement,
+   and when it has no line information */
+static int js_debug_line_of(JSFunctionBytecode *b, int pos)
+{
+    const uint8_t *p, *p_end;
+    int base, line, new_line, pc, start, v, ret;
+    uint32_t val;
+    unsigned int op;
+
+    if (!b->has_debug || !b->debug.pc2line_buf || pos < 0 ||
+        pos >= b->byte_code_len)
+        return 0;
+    if (!b->debug_lines) {
+        /* debugger state, so it stays out of the runtime's memory limit;
+           the parentheses step around the macro that forbids malloc */
+        int *lines = (malloc)(sizeof(int) * b->byte_code_len);
+        if (!lines)
+            return 0;
+        p = b->debug.pc2line_buf;
+        p_end = p + b->debug.pc2line_len;
+        ret = get_leb128(&val, p, p_end);
+        if (ret < 0)
+            goto fail;
+        p += ret;
+        base = val + 1;
+        ret = get_leb128(&val, p, p_end); /* the function's column */
+        if (ret < 0)
+            goto fail;
+        p += ret;
+        pc = 0;
+        start = 0;
+        /* the prologue runs before the first entry, on no line of its own */
+        line = 0;
+        while (p < p_end) {
+            op = *p++;
+            if (op == 0) {
+                ret = get_leb128(&val, p, p_end);
+                if (ret < 0)
+                    goto fail;
+                pc += val;
+                p += ret;
+                ret = get_sleb128(&v, p, p_end);
+                if (ret < 0)
+                    goto fail;
+                p += ret;
+                new_line = base + v;
+            } else {
+                op -= PC2LINE_OP_FIRST;
+                pc += (op / PC2LINE_RANGE);
+                new_line = base + (op % PC2LINE_RANGE) + PC2LINE_BASE;
+            }
+            base = new_line;
+            ret = get_sleb128(&v, p, p_end); /* the column */
+            if (ret < 0)
+                goto fail;
+            p += ret;
+            for (; start < pc && start < b->byte_code_len; start++)
+                lines[start] = line;
+            line = new_line;
+        }
+        for (; start < b->byte_code_len; start++)
+            lines[start] = line;
+        b->debug_lines = lines;
+        goto done;
+    fail:
+        (free)(lines);
+        return 0;
+    }
+ done:
+    return b->debug_lines[pos];
+}
+
+/* JSPrismarine: runs before each instruction of a frame on the debugger's
+   dispatch table, and calls the line hook when the frame reaches a new line
+   or jumps back. `pc` is just past the opcode. */
+static no_inline int js_debug_instruction(JSContext *ctx, JSStackFrame *sf,
+                                          const uint8_t *pc)
+{
+    JSRuntime *rt = ctx->rt;
+    JSFunctionBytecode *b;
+    int pos, line;
+
+    if (!rt->debug_line_hook)
+        return 0;
+    b = JS_VALUE_GET_OBJ(sf->cur_func)->u.func.function_bytecode;
+    pos = pc - b->byte_code_buf - 1;
+    sf->cur_pc = pc;
+    line = js_debug_line_of(b, pos);
+    if (line == sf->debug_line && pos >= sf->debug_pos) {
+        sf->debug_pos = pos;
+        if (rt->debug_last_frame == sf || line <= 0)
+            return 0;
+        /* a call into script has returned to this frame mid-line */
+        rt->debug_last_frame = sf;
+        return rt->debug_line_hook(ctx, rt->debug_opaque, b->debug.filename,
+                                   line, TRUE);
+    }
+    rt->debug_last_frame = sf;
+    sf->debug_line = line;
+    sf->debug_pos = pos;
+    if (line <= 0)
+        return 0;
+    return rt->debug_line_hook(ctx, rt->debug_opaque, b->debug.filename,
+                               line, FALSE);
+}
