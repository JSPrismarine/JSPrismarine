+/* JSPrismarine: what a debugger reads from a paused script */
+
+void JS_SetDebugHooks(JSRuntime *rt, JSDebugLineHook *line_hook,
+                      JSDebugThrowHook *throw_hook, void *opaque)
+{
+    rt->debug_line_hook = line_hook;
+    rt->debug_throw_hook = throw_hook;
+    rt->debug_opaque = opaque;
+    rt->debug_throw_pending = FALSE;
+}
+
+static JSStackFrame *js_debug_frame(JSContext *ctx, int level)
+{
+    JSStackFrame *sf;
+
+    if (level < 0)
+        return NULL;
+    for (sf = ctx->rt->current_stack_frame; sf && level > 0; level--)
+        sf = sf->prev_frame;
+    return sf;
+}
+
+/* the function a frame runs, when it runs bytecode */
+static JSObject *js_debug_bytecode_function(JSStackFrame *sf)
+{
+    JSObject *p;
+
+    if (!sf || JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return NULL;
+    p = JS_VALUE_GET_OBJ(sf->cur_func);
+    return js_class_has_bytecode(p->class_id) ? p : NULL;
+}
+
+int JS_GetDebugStackDepth(JSContext *ctx)
+{
+    JSStackFrame *sf;
+    int depth = 0;
+
+    for (sf = ctx->rt->current_stack_frame; sf; sf = sf->prev_frame)
+        depth++;
+    return depth;
+}
+
+JSContext *JS_GetDebugFrameRealm(JSContext *ctx, int level)
+{
+    JSStackFrame *sf = js_debug_frame(ctx, level);
+    JSObject *p;
+
+    if (!sf || JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return NULL;
+    p = JS_VALUE_GET_OBJ(sf->cur_func);
+    if (js_class_has_bytecode(p->class_id))
+        return p->u.func.function_bytecode->realm;
+    if (p->class_id == JS_CLASS_C_FUNCTION)
+        return p->u.cfunc.realm;
+    return NULL;
+}
+
+int JS_GetDebugFrame(JSContext *ctx, int level, const char **function_name,
+                     const char **filename, int *line, int *column)
+{
+    JSStackFrame *sf = js_debug_frame(ctx, level);
+    JSObject *p;
+    JSFunctionBytecode *b;
+
+    *function_name = NULL;
+    *filename = NULL;
+    *line = 0;
+    *column = 0;
+    if (!sf)
+        return -1;
+    *function_name = get_prop_string(ctx, sf->cur_func, JS_ATOM_name);
+    p = js_debug_bytecode_function(sf);
+    if (p) {
+        b = p->u.func.function_bytecode;
+        if (b->has_debug) {
+            *filename = JS_AtomToCString(ctx, b->debug.filename);
+            *line = find_line_num(ctx, b, sf->cur_pc - b->byte_code_buf - 1,
+                                  column);
+        }
+    }
+    return 0;
+}
