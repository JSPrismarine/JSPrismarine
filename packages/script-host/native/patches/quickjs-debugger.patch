+/* whether a variable's name is one a script can write */
+static BOOL js_debug_is_visible(JSContext *ctx, JSAtom name)
+{
+    char buf[ATOM_GET_STR_BUF_SIZE];
+    const char *str;
+
+    if (name == JS_ATOM_new_target || name == JS_ATOM_this_active_func)
+        return FALSE;
+    str = JS_AtomGetStr(ctx, buf, sizeof(buf), name);
+    return str[0] != '<';
+}
+
+static int js_debug_add(JSContext *ctx, JSValueConst obj, JSAtom name,
+                        JSValueConst val)
+{
+    if (JS_IsUninitialized(val) || !js_debug_is_visible(ctx, name))
+        return 0;
+    return JS_DefinePropertyValue(ctx, obj, name, JS_DupValue(ctx, val),
+                                  JS_PROP_C_W_E);
+}
+
+JSValue JS_GetDebugLocals(JSContext *ctx, int level)
+{
+    JSStackFrame *sf = js_debug_frame(ctx, level);
+    JSObject *p = js_debug_bytecode_function(sf);
+    JSFunctionBytecode *b;
+    JSValue ret;
+    int i;
+
+    ret = JS_NewObjectProto(ctx, JS_NULL);
+    if (JS_IsException(ret) || !p)
+        return ret;
+    b = p->u.func.function_bytecode;
+    if (!b->vardefs)
+        return ret;
+    for (i = 0; i < b->arg_count + b->var_count; i++) {
+        JSValueConst val = i < b->arg_count ? sf->arg_buf[i] :
+            sf->var_buf[i - b->arg_count];
+        if (js_debug_add(ctx, ret, b->vardefs[i].var_name, val) < 0) {
+            JS_FreeValue(ctx, ret);
+            return JS_EXCEPTION;
+        }
+    }
+    return ret;
+}
+
+JSValue JS_GetDebugClosure(JSContext *ctx, int level)
+{
+    JSObject *p = js_debug_bytecode_function(js_debug_frame(ctx, level));
+    JSFunctionBytecode *b;
+    JSVarRef *var_ref;
+    JSValue ret;
+    int i;
+
+    ret = JS_NewObjectProto(ctx, JS_NULL);
+    if (JS_IsException(ret) || !p || !p->u.func.var_refs)
+        return ret;
+    b = p->u.func.function_bytecode;
+    for (i = 0; i < b->closure_var_count; i++) {
+        var_ref = p->u.func.var_refs[i];
+        if (!var_ref || !var_ref->pvalue)
+            continue;
+        if (js_debug_add(ctx, ret, b->closure_var[i].var_name,
+                         *var_ref->pvalue) < 0) {
+            JS_FreeValue(ctx, ret);
+            return JS_EXCEPTION;
+        }
+    }
+    return ret;
+}
+
+JSValue JS_DebugEvaluate(JSContext *ctx, int level, const char *source,
+                         size_t length)
+{
+    JSStackFrame *sf = js_debug_frame(ctx, level);
+    JSObject *p = js_debug_bytecode_function(sf);
+    JSParseState s1, *s = &s1;
+    JSFunctionBytecode *b;
+    JSFunctionDef *fd;
+    JSVarRef *var_ref;
+    JSValue fun_obj, ret;
+    int i, interrupt_counter;
+
+    /* the stopped script polls for interrupts as if nothing had run */
+    interrupt_counter = ctx->interrupt_counter;
+    if (!p) {
+        ret = JS_Eval(ctx, source, length, "<debugger>", JS_EVAL_TYPE_GLOBAL);
+        ctx->interrupt_counter = interrupt_counter;
+        return ret;
+    }
+    b = p->u.func.function_bytecode;
+
+    /* compiled as __JS_EvalInternal compiles a direct eval */
+    js_parse_init(ctx, s, source, length, "<debugger>");
+    skip_shebang(&s->buf_ptr, s->buf_end);
+    fd = js_new_function_def(ctx, NULL, TRUE, FALSE, "<debugger>",
+                             s->buf_start, &s->get_line_col_cache);
+    if (!fd)
+        return JS_EXCEPTION;
+    s->cur_func = fd;
+    fd->eval_type = JS_EVAL_TYPE_DIRECT;
+    fd->has_this_binding = FALSE;
+    fd->new_target_allowed = b->new_target_allowed;
+    fd->super_call_allowed = b->super_call_allowed;
+    fd->super_allowed = b->super_allowed;
+    fd->arguments_allowed = b->arguments_allowed;
+    fd->js_mode = b->js_mode;
+    fd->func_name = JS_DupAtom(ctx, JS_ATOM__eval_);
+    if (add_closure_variables(ctx, fd, b, JS_DEBUG_SCOPE_INDEX))
+        goto fail;
+    s->is_module = FALSE;
+    s->allow_html_comments = TRUE;
+    push_scope(s); /* body scope */
+    fd->body_scope = fd->scope_level;
+    if (js_parse_program(s)) {
+    fail:
+        free_token(s, &s->token);
+        js_free_function_def(ctx, fd);
+        return JS_EXCEPTION;
+    }
+    fun_obj = js_create_function(ctx, fd);
+    if (JS_IsException(fun_obj))
+        return JS_EXCEPTION;
+    fun_obj = js_closure(ctx, fun_obj, p->u.func.var_refs, sf, TRUE);
+    if (JS_IsException(fun_obj))
+        return JS_EXCEPTION;
+    ret = JS_Call(ctx, fun_obj, JS_UNDEFINED, 0, NULL);
+    ctx->interrupt_counter = interrupt_counter;
+
+    /* a closure the evaluation made keeps a copy of each borrowed slot */
+    p = JS_VALUE_GET_OBJ(fun_obj);
+    for (i = 0; i < p->u.func.function_bytecode->closure_var_count; i++) {
+        var_ref = p->u.func.var_refs[i];
+        if (var_ref && var_ref->is_detached &&
+            var_ref->pvalue != &var_ref->value) {
+            var_ref->value = JS_DupValue(ctx, *var_ref->pvalue);
+            var_ref->pvalue = &var_ref->value;
+        }
+    }
+    JS_FreeValue(ctx, fun_obj);
+    return ret;
+}
+
+JSValue JS_GetDebugClassName(JSContext *ctx, JSValueConst obj)
+{
+    return js_object___getClass(ctx, JS_UNDEFINED, 1, &obj);
+}
+
+JS_BOOL JS_IsDebugProxy(JSValueConst obj)
+{
+    return JS_VALUE_GET_TAG(obj) == JS_TAG_OBJECT &&
+           JS_VALUE_GET_OBJ(obj)->class_id == JS_CLASS_PROXY;
+}
