+/* JSPrismarine: JS_ExecutePendingJob for the first pending job whose realm
+   is `realm`, leaving the jobs of other contexts in their order */
+int JS_ExecutePendingJobOf(JSRuntime *rt, JSContext *realm)
+{
+    struct list_head *el;
+    JSJobEntry *e;
+    JSValue res;
+    int i, ret;
+
+    list_for_each(el, &rt->job_list) {
+        e = list_entry(el, JSJobEntry, link);
+        if (e->realm != realm)
+            continue;
+        list_del(&e->link);
+        res = e->job_func(realm, e->argc, (JSValueConst *)e->argv);
+        for(i = 0; i < e->argc; i++)
+            JS_FreeValue(realm, e->argv[i]);
+        ret = JS_IsException(res) ? -1 : 1;
+        JS_FreeValue(realm, res);
+        js_free(realm, e);
+        JS_FreeContext(realm);
+        return ret;
+    }
+    return 0;
+}
