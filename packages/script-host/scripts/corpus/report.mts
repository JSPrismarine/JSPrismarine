/**
 * Writes the corpus counts as the two checked-in files: `usage.json`, every pack's uses with one
 * key per line in sorted order so a recount diffs line by line, and `ranking.md`, the modules,
 * declarations, events and members ordered by how many packs use them, split by whether the pack
 * declares the module as stable or beta.
 */
import type { VersionStability } from '../../src/shape/format.ts';
import type { CorpusManifest } from './manifest.mts';
import type { PackUsage } from './pack.mts';

/** The command that regenerates the files, which both name. */
export const COUNT_COMMAND = 'pnpm --filter @jsprismarine/script-host run count:corpus';

/** The `bedrock-samples` checkout the shape the counts resolve against comes from. */
export interface ShapeSource {
    readonly repo: string;
    readonly tag: string;
    readonly commit: string;
}

function sortedObject<Value>(map: ReadonlyMap<string, Value>): Record<string, Value> {
    return Object.fromEntries([...map].sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)));
}

/** The text of `usage.json`. */
export const usageJson = (packs: readonly PackUsage[], shape: ShapeSource): string => {
    const content = {
        $comment: `Generated by \`${COUNT_COMMAND}\` from corpus/packs.json. Do not edit.`,
        shape,
        packs: Object.fromEntries(
            [...packs]
                .sort((a, b) => (a.id < b.id ? -1 : 1))
                .map((pack) => [
                    pack.id,
                    {
                        files: pack.files,
                        modules: Object.fromEntries(
                            [...pack.modules].map(([module, usage]) => [
                                module,
                                {
                                    ...(usage.declared === undefined ? {} : { declared: usage.declared }),
                                    stability: usage.stability,
                                    ...(usage.shape === undefined ? {} : { shape: usage.shape }),
                                    uses: sortedObject(usage.uses),
                                    fields: sortedObject(usage.fields),
                                    unmatched: sortedObject(usage.unmatched)
                                }
                            ])
                        ),
                        ...(pack.parseErrors.size === 0 ? {} : { parseErrors: sortedObject(pack.parseErrors) })
                    }
                ])
        )
    };
    return `${JSON.stringify(content, undefined, 4)}\n`;
};

/** One row of a ranking: how many packs use something, and how often in all. */
interface Tally {
    readonly packs: Set<string>;
    occurrences: number;
}

/** Tallies by stability, then by `module key`. */
type Tallies = Record<VersionStability, Map<string, Tally>>;

const newTallies = (): Tallies => ({ stable: new Map(), beta: new Map() });

const tally = (tallies: Tallies, stability: VersionStability, key: string, pack: string, occurrences: number): void => {
    const map = tallies[stability];
    let entry = map.get(key);
    if (entry === undefined) {
        entry = { packs: new Set(), occurrences: 0 };
        map.set(key, entry);
    }
    entry.packs.add(pack);
    entry.occurrences += occurrences;
};

/** Ordered by pack count, then occurrences, then name. */
const ranked = (map: ReadonlyMap<string, Tally>): [string, Tally][] =>
    [...map].sort(
        ([a, left], [b, right]) =>
            right.packs.size - left.packs.size || right.occurrences - left.occurrences || (a < b ? -1 : a > b ? 1 : 0)
    );

/** A module's name without the `@minecraft/` scope, for tables. */
const shortModule = (module: string): string => module.replace(/^@minecraft\//, '');

/** Splits a tally key back into its module and name. */
const splitKey = (key: string): [string, string] => {
    const space = key.indexOf(' ');
    return [key.slice(0, space), key.slice(space + 1)];
};

/** Whether a key names an event: a member of a `*AfterEvents` or `*BeforeEvents` class. */
const isEvent = (name: string): boolean => /^\w+(After|Before)Events\.\w+$/.test(name);

const table = (header: readonly string[], rows: readonly (readonly (string | number)[])[]): string[] => [
    `| ${header.join(' | ')} |`,
    `| ${header.map((cell) => (/^(Packs|Uses|#)$/.test(cell) ? '---:' : '---')).join(' | ')} |`,
    ...rows.map((row) => `| ${row.join(' | ')} |`)
];

const rankingTable = (map: ReadonlyMap<string, Tally>): string[] => {
    const rows = ranked(map).map(([key, entry], index) => {
        const [module, name] = splitKey(key);
        return [index + 1, `\`${name}\``, shortModule(module), entry.packs.size, entry.occurrences];
    });
    return rows.length === 0 ? ['None.'] : table(['#', 'Name', 'Module', 'Packs', 'Uses'], rows);
};

/** The text of `ranking.md`. */
export const rankingMarkdown = (manifest: CorpusManifest, packs: readonly PackUsage[], shape: ShapeSource): string => {
    const modules = newTallies();
    const declarations = newTallies();
    const events = newTallies();
    const members = newTallies();
    const fields = newTallies();
    const unmatched = newTallies();
    for (const pack of packs) {
        for (const [module, usage] of pack.modules) {
            tally(modules, usage.stability, `${module} ${module}`, pack.id, 0);
            const used = new Map<string, number>();
            for (const [key, count] of usage.uses) {
                const owner = key.split('.')[0] ?? key;
                used.set(owner, (used.get(owner) ?? 0) + count);
                if (key.includes('.')) tally(members, usage.stability, `${module} ${key}`, pack.id, count);
                if (isEvent(key)) tally(events, usage.stability, `${module} ${key}`, pack.id, count);
            }
            for (const [owner, count] of used)
                tally(declarations, usage.stability, `${module} ${owner}`, pack.id, count);
            for (const [key, count] of usage.fields) tally(fields, usage.stability, `${module} ${key}`, pack.id, count);
            for (const [key, count] of usage.unmatched)
                tally(unmatched, usage.stability, `${module} ${key}`, pack.id, count);
        }
    }

    const repositories = new Map(
        manifest.repositories.flatMap((repository) => repository.packs.map((pack) => [pack.id, repository] as const))
    );
    const packRows = [...packs]
        .sort((a, b) => (a.id < b.id ? -1 : 1))
        .map((pack) => {
            const repository = repositories.get(pack.id);
            const versions = [...pack.modules]
                .filter(([, usage]) => usage.declared !== undefined)
                .map(([module, usage]) => `${shortModule(module)} ${usage.declared}`)
                .join(', ');
            const language = pack.files.typescript > 0 ? 'TypeScript' : 'JavaScript';
            return [
                pack.id,
                repository === undefined ? '' : `[${repository.name}](${repository.url}/tree/${repository.commit})`,
                repository?.license ?? '',
                `${pack.files.javascript + pack.files.typescript} ${language}`,
                versions
            ];
        });

    const moduleRows = [...new Set([...modules.stable.keys(), ...modules.beta.keys()])].sort().map((key) => {
        const [module] = splitKey(key);
        return [`\`${module}\``, modules.stable.get(key)?.packs.size ?? 0, modules.beta.get(key)?.packs.size ?? 0];
    });

    const lines = [
        '# Add-on corpus usage',
        '',
        `Generated by \`${COUNT_COMMAND}\` from [packs.json](packs.json). Do not edit.`,
        '',
        `Members resolve against the shape generated from ${shape.repo} ${shape.tag} (\`${shape.commit}\`).`,
        'A pack counts toward the stable or the beta ranking by the version its manifest declares for',
        'the module. The shape has no beta versions yet, so a beta pack resolves against the newest',
        'stable version of its major version, and members only a beta version has are listed under',
        '"Not in the shape", beside members a script reads on the wrong type. A member a pack adds to',
        "an API type through `declare module` is the pack's own and is not counted. Fields of interfaces,",
        'such as `Vector3.x`, are plain object properties and are ranked apart from members. A pack',
        'counts once per name however often it uses it; Uses counts every occurrence.',
        '',
        '## Packs',
        '',
        ...table(['Pack', 'Repository', 'License', 'Scripts', 'Modules'], packRows),
        '',
        '## Modules',
        '',
        ...table(['Module', 'Stable packs', 'Beta packs'], moduleRows),
        ''
    ];
    for (const [title, tallies] of [
        ['Declarations', declarations],
        ['Events', events],
        ['Members', members],
        ['Interface fields', fields],
        ['Not in the shape', unmatched]
    ] as const) {
        for (const stability of ['stable', 'beta'] as const) {
            lines.push(`## ${title}, ${stability} packs`, '', ...rankingTable(tallies[stability]), '');
        }
    }
    return lines.join('\n');
};
