/**
 * Lays a generated shape out as the files under `src/generated/`: one history per module, an index
 * that imports them, and the member names implementations register against.
 */
import type { ModuleHistory } from '../../src/shape/format.ts';
import type { GeneratedShape } from './generate.mts';
import { printHistory } from './generate.mts';
import type { SamplesPin } from './locate.mts';

/** The generated directory, relative to the package. */
export const GENERATED_DIR = 'src/generated';

/** How an implementation can bind a member, as `scriptApi.ts` records it. */
type MemberSlot = 'method' | 'constructor' | 'getter' | 'accessor';

const SCOPE = '@minecraft/';

/** `@minecraft/server-ui` is written as `server-ui.json`. */
const fileStem = (module: string): string => (module.startsWith(SCOPE) ? module.slice(SCOPE.length) : module);

/** `server-ui` is imported as `serverUi`. */
const identifier = (stem: string): string =>
    stem.replace(/-([a-z])/g, (_match, letter: string) => letter.toUpperCase());

const header = (pin: SamplesPin): string =>
    `// Generated by \`pnpm --filter @jsprismarine/script-host run generate:shape\` from ${pin.repo} ${pin.tag}\n` +
    `// (${pin.commit}). Do not edit: change scripts/shape/ and regenerate.\n`;

/** Each class's members with the ways an implementation can bind them, over every version. */
const slotsOf = (history: ModuleHistory): Map<string, Map<string, Set<MemberSlot>>> => {
    const owners = new Map<string, Map<string, Set<MemberSlot>>>();
    const add = (owner: string, member: string, slot: MemberSlot): void => {
        const members = owners.get(owner) ?? new Map<string, Set<MemberSlot>>();
        owners.set(owner, members);
        const slots = members.get(member) ?? new Set<MemberSlot>();
        members.set(member, slots);
        slots.add(slot);
    };
    for (const [name, declaration] of Object.entries(history.declarations)) {
        for (const segment of declaration.segments) {
            if (segment.kind === 'function') add('', name, 'method');
        }
        if (!declaration.segments.some((segment) => segment.kind === 'class')) continue;
        // An iterable class's `next` is implied by its `iterator`, not listed as a member.
        if (declaration.segments.some((segment) => segment.kind === 'class' && segment.iterator !== undefined)) {
            add(name, 'next', 'method');
        }
        for (const [member, segments] of Object.entries(declaration.members ?? {})) {
            for (const segment of segments) {
                if (segment.kind === 'method') add(name, member, 'method');
                else if (segment.kind === 'constructor') add(name, member, 'constructor');
                else if (segment.kind === 'property') add(name, member, segment.readOnly ? 'getter' : 'accessor');
            }
        }
    }
    return owners;
};

const printApi = (shape: GeneratedShape, pin: SamplesPin): string => {
    const lines = [
        header(pin),
        '/**',
        ' * Every member an implementation can register, by module and class, with how it binds: a',
        " * `method`, a `constructor`, a read-only property's `getter`, or a writable property's",
        ' * `accessor`. It covers every generated version, so a member removed in a newer version stays',
        ' * registrable for packs that resolve to an older one. The empty class name holds module-level',
        ' * functions, and an iterable class has the `next` its `iterator` implies.',
        ' */',
        'export interface ScriptApiMembers {'
    ];
    for (const [module, history] of shape.histories) {
        lines.push(`    ${JSON.stringify(module)}: {`);
        const owners = [...slotsOf(history)].sort(([left], [right]) => (left < right ? -1 : 1));
        for (const [owner, members] of owners) {
            lines.push(`        ${JSON.stringify(owner)}: {`);
            for (const [member, slots] of [...members].sort(([left], [right]) => (left < right ? -1 : 1))) {
                const union = [...slots]
                    .sort()
                    .map((slot) => `'${slot}'`)
                    .join(' | ');
                lines.push(`            ${JSON.stringify(member)}: ${union};`);
            }
            lines.push('        };');
        }
        lines.push('    };');
    }
    lines.push('}', '');
    return lines.join('\n');
};

const printIndex = (shape: GeneratedShape, pin: SamplesPin): string => {
    const modules = [...shape.histories.keys()].map((module) => ({ module, name: identifier(fileStem(module)) }));
    return [
        header(pin),
        "import type { ModuleHistory } from '../shape/format.ts';",
        ...modules.map(
            ({ module, name }) =>
                `import ${name} from './script-modules/${fileStem(module)}.json' with { type: 'json' };`
        ),
        '',
        '/** The `bedrock-samples` checkout the histories come from. */',
        `export const SCRIPT_METADATA_SOURCE = ${JSON.stringify(pin)} as const;`,
        '',
        '/**',
        ' * Every generated module history, by module name. The JSON files are written in the layout',
        " * `../shape/format.ts` describes, which the compiler cannot see in an imported JSON file's type.",
        ' */',
        'export const SCRIPT_MODULE_HISTORIES: Readonly<Record<string, ModuleHistory>> = {',
        modules.map(({ module, name }) => `    ${JSON.stringify(module)}: ${name} as ModuleHistory`).join(',\n'),
        '};',
        ''
    ].join('\n');
};

/**
 * The generated files, by path relative to the package.
 * @param shape - The generator's result.
 * @param pin - The checkout it read.
 */
export const emitShape = (shape: GeneratedShape, pin: SamplesPin): Map<string, string> => {
    const files = new Map<string, string>();
    for (const [module, history] of shape.histories) {
        files.set(`${GENERATED_DIR}/script-modules/${fileStem(module)}.json`, printHistory(history));
    }
    files.set(`${GENERATED_DIR}/scriptModules.ts`, printIndex(shape, pin));
    files.set(`${GENERATED_DIR}/scriptApi.ts`, printApi(shape, pin));
    return files;
};
