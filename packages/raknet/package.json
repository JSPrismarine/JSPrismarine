{
    "name": "@jsprismarine/raknet",
    "version": "0.17.0",
    "description": "Basic RakNet implementation written in TypeScript",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.js",
                "module": "./dist/*.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./*": {
            "jsprismarine:dist": "./dist/*.js",
            "default": "./src/*.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "bench:reliability": "vitest bench benchmarks/reliability.stall.bench.ts",
        "bench:reliability:steady": "node ../../scripts/run-ts.mjs benchmarks/reliability.steady.bench.ts",
        "bench:reliability:loss": "node ../../scripts/run-ts.mjs benchmarks/reliability.loss.bench.ts",
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json",
        "bench:frame-set-sends": "vitest bench benchmarks/frame-set-sends.bench.ts",
        "bench:worker-transport": "node --import tsx benchmarks/workerTransport.bench.ts",
        "bench:socket-buffers": "node benchmarks/socketBuffers.bench.mjs",
        "bench:offline-ping": "node benchmarks/offlinePing.bench.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "nodejs",
        "raknet"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/raknet",
    "dependencies": {
        "@jsprismarine/binaryutils": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.4",
        "rimraf": "6.1.4",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    }
}
