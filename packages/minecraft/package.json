{
    "name": "@jsprismarine/minecraft",
    "version": "0.18.0",
    "description": "Minecraft: Bedrock Edition data and related utilities",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.js",
                "module": "./dist/*.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./datagen/paths": "./datagen/paths.ts",
        "./*": {
            "jsprismarine:dist": "./dist/*.js",
            "default": "./src/*.ts"
        },
        "./package.json": "./package.json"
    },
    "funding": "https://github.com/sponsors/JSPrismarine",
    "scripts": {
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json",
        "generate": "node datagen/import-schemas.js && node datagen/generate-enums.js && node datagen/generate-blocks.js && node datagen/generate-recipes.js",
        "generate:import": "node datagen/import-schemas.js",
        "generate:enums": "node datagen/generate-enums.js",
        "generate:verify": "node datagen/generate-enums.js --verify",
        "generate:compare": "node datagen/generate-enums.js --compare",
        "generate:blocks": "node datagen/generate-blocks.js",
        "generate:recipes": "node datagen/generate-recipes.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "protocol-data",
        "minecraft-data",
        "minecraft"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/minecraft",
    "devDependencies": {
        "@jsprismarine/binaryutils": "workspace:*",
        "@jsprismarine/leveldb": "workspace:*",
        "@types/node": "26.6.6",
        "@types/semver": "7.8.0",
        "glob": "14.0.4",
        "typescript": "7.0.2",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    },
    "dependencies": {
        "@jsprismarine/errors": "workspace:*",
        "@jsprismarine/nbt": "workspace:*"
    }
}
