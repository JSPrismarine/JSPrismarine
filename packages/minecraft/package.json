{
    "name": "@jsprismarine/minecraft",
    "version": "0.23.0",
    "description": "Minecraft: Bedrock Edition data and related utilities",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./ActorDataID": {
                "types": "./dist/ActorDataID.d.ts",
                "import": "./dist/ActorDataID.js",
                "module": "./dist/ActorDataID.js"
            },
            "./ActorFlags": {
                "types": "./dist/ActorFlags.d.ts",
                "import": "./dist/ActorFlags.js",
                "module": "./dist/ActorFlags.js"
            },
            "./BlockSchemaCatalog": {
                "types": "./dist/BlockSchemaCatalog.d.ts",
                "import": "./dist/BlockSchemaCatalog.js",
                "module": "./dist/BlockSchemaCatalog.js"
            },
            "./generated/block-schemas": {
                "types": "./dist/generated/block-schemas.d.ts",
                "import": "./dist/generated/block-schemas.js",
                "module": "./dist/generated/block-schemas.js"
            },
            "./generated/v2193/ActorEvent": {
                "types": "./dist/generated/v2193/ActorEvent.d.ts",
                "import": "./dist/generated/v2193/ActorEvent.js",
                "module": "./dist/generated/v2193/ActorEvent.js"
            },
            "./generated/v2193/ContainerUiId": {
                "types": "./dist/generated/v2193/ContainerUiId.d.ts",
                "import": "./dist/generated/v2193/ContainerUiId.js",
                "module": "./dist/generated/v2193/ContainerUiId.js"
            },
            "./generated/v2193/block-schemas": {
                "types": "./dist/generated/v2193/block-schemas.d.ts",
                "import": "./dist/generated/v2193/block-schemas.js",
                "module": "./dist/generated/v2193/block-schemas.js"
            },
            "./generated/v2225/ActorEvent": {
                "types": "./dist/generated/v2225/ActorEvent.d.ts",
                "import": "./dist/generated/v2225/ActorEvent.js",
                "module": "./dist/generated/v2225/ActorEvent.js"
            },
            "./generated/v2225/ContainerUiId": {
                "types": "./dist/generated/v2225/ContainerUiId.d.ts",
                "import": "./dist/generated/v2225/ContainerUiId.js",
                "module": "./dist/generated/v2225/ContainerUiId.js"
            },
            "./generated/v2225/block-schemas": {
                "types": "./dist/generated/v2225/block-schemas.d.ts",
                "import": "./dist/generated/v2225/block-schemas.js",
                "module": "./dist/generated/v2225/block-schemas.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./datagen/paths": "./datagen/paths.ts",
        "./ActorDataID": {
            "jsprismarine:dist": "./dist/ActorDataID.js",
            "default": "./src/ActorDataID.ts"
        },
        "./ActorFlags": {
            "jsprismarine:dist": "./dist/ActorFlags.js",
            "default": "./src/ActorFlags.ts"
        },
        "./BlockSchemaCatalog": {
            "jsprismarine:dist": "./dist/BlockSchemaCatalog.js",
            "default": "./src/BlockSchemaCatalog.ts"
        },
        "./generated/block-schemas": {
            "jsprismarine:dist": "./dist/generated/block-schemas.js",
            "default": "./src/generated/block-schemas.ts"
        },
        "./generated/v2193/ActorEvent": {
            "jsprismarine:dist": "./dist/generated/v2193/ActorEvent.js",
            "default": "./src/generated/v2193/ActorEvent.ts"
        },
        "./generated/v2193/ContainerUiId": {
            "jsprismarine:dist": "./dist/generated/v2193/ContainerUiId.js",
            "default": "./src/generated/v2193/ContainerUiId.ts"
        },
        "./generated/v2193/block-schemas": {
            "jsprismarine:dist": "./dist/generated/v2193/block-schemas.js",
            "default": "./src/generated/v2193/block-schemas.ts"
        },
        "./generated/v2225/ActorEvent": {
            "jsprismarine:dist": "./dist/generated/v2225/ActorEvent.js",
            "default": "./src/generated/v2225/ActorEvent.ts"
        },
        "./generated/v2225/ContainerUiId": {
            "jsprismarine:dist": "./dist/generated/v2225/ContainerUiId.js",
            "default": "./src/generated/v2225/ContainerUiId.ts"
        },
        "./generated/v2225/block-schemas": {
            "jsprismarine:dist": "./dist/generated/v2225/block-schemas.js",
            "default": "./src/generated/v2225/block-schemas.ts"
        },
        "./package.json": "./package.json"
    },
    "funding": "https://github.com/sponsors/JSPrismarine",
    "scripts": {
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json",
        "generate": "node datagen/import-schemas.js && node datagen/generate-enums.js && node datagen/generate-blocks.js",
        "generate:import": "node datagen/import-schemas.js",
        "generate:enums": "node datagen/generate-enums.js",
        "generate:verify": "node datagen/generate-enums.js --verify",
        "generate:compare": "node datagen/generate-enums.js --compare",
        "generate:blocks": "node datagen/generate-blocks.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "protocol-data",
        "minecraft-data",
        "minecraft"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/minecraft",
    "devDependencies": {
        "@jsprismarine/binaryutils": "workspace:*",
        "@jsprismarine/leveldb": "workspace:*",
        "@types/node": "26.6.6",
        "@types/semver": "7.8.0",
        "glob": "14.0.6",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "dependencies": {
        "@jsprismarine/errors": "workspace:*",
        "@jsprismarine/nbt": "workspace:*"
    }
}
