{
    "name": "@jsprismarine/protocol",
    "version": "0.16.0",
    "description": "Protocol package used by JSPrismarine packages",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.es.js",
                "module": "./dist/index.es.js"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.es.js",
                "module": "./dist/*.es.js"
            },
            "./payload": {
                "types": "./dist/payload/index.d.ts",
                "import": "./dist/payload/index.es.js",
                "module": "./dist/payload/index.es.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.es.js",
            "default": "./src/index.ts"
        },
        "./payload": {
            "jsprismarine:dist": "./dist/payload/index.es.js",
            "default": "./src/payload/index.ts"
        },
        "./*": {
            "jsprismarine:dist": "./dist/*.es.js",
            "default": "./src/*.ts"
        },
        "./package.json": "./package.json"
    },
    "funding": "https://github.com/sponsors/JSPrismarine",
    "scripts": {
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "bench:compression": "vitest bench benchmarks/compression.bench.ts",
        "bench:compression-variants": "vitest bench benchmarks/compression-variants.bench.ts",
        "bench:batch-codec": "node ../../scripts/run-ts.mjs benchmarks/batchCodec.bench.mjs",
        "bench:layout": "node ../../scripts/run-ts.mjs benchmarks/layout.bench.ts",
        "bench:layout-cache": "node ../../scripts/run-ts.mjs bench/layout.bench.ts",
        "test:dist-contract": "node --conditions=jsprismarine:dist --import tsx scripts/check-packet-class-names.mjs",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "minecraft-protocol",
        "protocol"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/protocol",
    "devDependencies": {
        "@jsprismarine/bedrock-data": "workspace:*",
        "@jsprismarine/packs": "workspace:*",
        "@mtcute/wasm": "0.32.6",
        "@types/node": "24.19.2",
        "glob": "13.0.6",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.1.0"
    },
    "dependencies": {
        "@jsprismarine/binaryutils": "workspace:*",
        "@jsprismarine/blocks": "workspace:*",
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/items": "workspace:*",
        "@jsprismarine/math": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*",
        "@jsprismarine/nbt": "workspace:*",
        "@jsprismarine/recipes": "workspace:*"
    }
}
