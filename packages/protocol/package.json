{
    "name": "@jsprismarine/protocol",
    "version": "0.16.0",
    "description": "Protocol package used by JSPrismarine packages",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.es.js",
                "module": "./dist/index.es.js"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.es.js",
                "module": "./dist/*.es.js"
            },
            "./payload": {
                "types": "./dist/payload/index.d.ts",
                "import": "./dist/payload/index.es.js",
                "module": "./dist/payload/index.es.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./src/index.ts",
        "./payload": "./src/payload/index.ts",
        "./*": "./src/*.ts",
        "./package.json": "./package.json"
    },
    "funding": "https://github.com/sponsors/JSPrismarine",
    "scripts": {
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "minecraft-protocol",
        "protocol"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/protocol",
    "devDependencies": {
        "@jsprismarine/bedrock-data": "workspace:*",
        "@jsprismarine/packs": "workspace:*",
        "@types/node": "24.19.2",
        "glob": "13.0.6",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "dependencies": {
        "@jsprismarine/binaryutils": "workspace:*",
        "@jsprismarine/blocks": "workspace:*",
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/items": "workspace:*",
        "@jsprismarine/math": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*",
        "@jsprismarine/nbt": "workspace:*",
        "@jsprismarine/recipes": "workspace:*"
    }
}
