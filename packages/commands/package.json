{
    "name": "@jsprismarine/commands",
    "version": "0.23.1",
    "description": "Data-driven command layer: Mojang's Bedrock command table, a Java-shaped command tree, the Bedrock packet flattener and the selector grammars.",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./argumentTypes": {
                "types": "./dist/argumentTypes.d.ts",
                "import": "./dist/argumentTypes.js",
                "module": "./dist/argumentTypes.js"
            },
            "./commands/support": {
                "types": "./dist/commands/support.d.ts",
                "import": "./dist/commands/support.js",
                "module": "./dist/commands/support.js"
            },
            "./flatten": {
                "types": "./dist/flatten.d.ts",
                "import": "./dist/flatten.js",
                "module": "./dist/flatten.js"
            },
            "./gamerules": {
                "types": "./dist/gamerules.d.ts",
                "import": "./dist/gamerules.js",
                "module": "./dist/gamerules.js"
            },
            "./host": {
                "types": "./dist/host.d.ts",
                "import": "./dist/host.js",
                "module": "./dist/host.js"
            },
            "./selector": {
                "types": "./dist/selector.d.ts",
                "import": "./dist/selector.js",
                "module": "./dist/selector.js"
            },
            "./syntaxError": {
                "types": "./dist/syntaxError.d.ts",
                "import": "./dist/syntaxError.js",
                "module": "./dist/syntaxError.js"
            },
            "./testing": {
                "types": "./dist/testing.d.ts",
                "import": "./dist/testing.js",
                "module": "./dist/testing.js"
            },
            "./tree": {
                "types": "./dist/tree.d.ts",
                "import": "./dist/tree.js",
                "module": "./dist/tree.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./argumentTypes": {
            "jsprismarine:dist": "./dist/argumentTypes.js",
            "default": "./src/argumentTypes.ts"
        },
        "./commands/support": {
            "jsprismarine:dist": "./dist/commands/support.js",
            "default": "./src/commands/support.ts"
        },
        "./flatten": {
            "jsprismarine:dist": "./dist/flatten.js",
            "default": "./src/flatten.ts"
        },
        "./gamerules": {
            "jsprismarine:dist": "./dist/gamerules.js",
            "default": "./src/gamerules.ts"
        },
        "./host": {
            "jsprismarine:dist": "./dist/host.js",
            "default": "./src/host.ts"
        },
        "./selector": {
            "jsprismarine:dist": "./dist/selector.js",
            "default": "./src/selector.ts"
        },
        "./syntaxError": {
            "jsprismarine:dist": "./dist/syntaxError.js",
            "default": "./src/syntaxError.ts"
        },
        "./testing": {
            "jsprismarine:dist": "./dist/testing.js",
            "default": "./src/testing.ts"
        },
        "./tree": {
            "jsprismarine:dist": "./dist/tree.js",
            "default": "./src/tree.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "generate:bedrock-commands": "node utils/generate/generate-bedrock-commands.ts",
        "generate:java-commands": "node utils/generate/generate-java-commands.ts",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "commands",
        "brigadier",
        "bedrock",
        "java-edition"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/commands",
    "dependencies": {
        "@jsprismarine/brigadier": "workspace:*",
        "@jsprismarine/errors": "workspace:*",
        "@jsprismarine/mapping": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.6",
        "prettier": "3.10.1",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    }
}
