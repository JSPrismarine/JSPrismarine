{
    "name": "@jsprismarine/commands",
    "version": "0.18.0",
    "description": "Data-driven command layer: Mojang's Bedrock command table, a Java-shaped command tree, the Bedrock packet flattener and the selector grammars.",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.js",
                "module": "./dist/*.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./*": {
            "jsprismarine:dist": "./dist/*.js",
            "default": "./src/*.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "generate:bedrock-commands": "node utils/generate/generate-bedrock-commands.ts",
        "generate:java-commands": "node utils/generate/generate-java-commands.ts",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "commands",
        "brigadier",
        "bedrock",
        "java-edition"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/commands",
    "dependencies": {
        "@jsprismarine/brigadier": "workspace:*",
        "@jsprismarine/mapping": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.4",
        "prettier": "3.9.10",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    }
}
