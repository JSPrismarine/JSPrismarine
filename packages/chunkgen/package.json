{
    "name": "@jsprismarine/chunkgen",
    "version": "0.19.1",
    "description": "Java Edition's chunk generation ladder: the ten statuses, the step table that declares what each one may read and write, and the proto chunk that crosses a thread boundary",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.js",
                "module": "./dist/*.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./*": {
            "jsprismarine:dist": "./dist/*.js",
            "default": "./src/*.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "worldgen",
        "chunk",
        "generation"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/chunkgen",
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.4",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.7",
        "vitest": "5.1.0"
    },
    "dependencies": {
        "piscina": "5.3.2"
    }
}
