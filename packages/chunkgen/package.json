{
    "name": "@jsprismarine/chunkgen",
    "version": "0.23.0",
    "description": "Java Edition's chunk generation ladder: the ten statuses, the step table that declares what each one may read and write, and the holders and worker pool that run them",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./GenerationPool": {
                "types": "./dist/GenerationPool.d.ts",
                "import": "./dist/GenerationPool.js",
                "module": "./dist/GenerationPool.js"
            },
            "./generationHost": {
                "types": "./dist/generationHost.d.ts",
                "import": "./dist/generationHost.js",
                "module": "./dist/generationHost.js"
            },
            "./hostRole": {
                "types": "./dist/hostRole.d.ts",
                "import": "./dist/hostRole.js",
                "module": "./dist/hostRole.js"
            },
            "./reusableInput": {
                "types": "./dist/reusableInput.d.ts",
                "import": "./dist/reusableInput.js",
                "module": "./dist/reusableInput.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./GenerationPool": {
            "jsprismarine:dist": "./dist/GenerationPool.js",
            "default": "./src/GenerationPool.ts"
        },
        "./generationHost": {
            "jsprismarine:dist": "./dist/generationHost.js",
            "default": "./src/generationHost.ts"
        },
        "./hostRole": {
            "jsprismarine:dist": "./dist/hostRole.js",
            "default": "./src/hostRole.ts"
        },
        "./reusableInput": {
            "jsprismarine:dist": "./dist/reusableInput.js",
            "default": "./src/reusableInput.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "worldgen",
        "chunk",
        "generation"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/chunkgen",
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "dependencies": {
        "@jsprismarine/errors": "workspace:*",
        "piscina": "5.3.2"
    }
}
