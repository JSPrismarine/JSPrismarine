{
    "name": "@jsprismarine/entity-goals",
    "version": "0.25.0",
    "description": "The 170 vanilla Bedrock AI goals and the A* path finder they navigate with, written against the goal seam of @jsprismarine/entities",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./goals/dragonPhases": {
                "types": "./dist/goals/dragonPhases.d.ts",
                "import": "./dist/goals/dragonPhases.js",
                "module": "./dist/goals/dragonPhases.js"
            },
            "./goals/mobAttacks": {
                "types": "./dist/goals/mobAttacks.d.ts",
                "import": "./dist/goals/mobAttacks.js",
                "module": "./dist/goals/mobAttacks.js"
            },
            "./goals/shoulder": {
                "types": "./dist/goals/shoulder.d.ts",
                "import": "./dist/goals/shoulder.js",
                "module": "./dist/goals/shoulder.js"
            },
            "./harness": {
                "types": "./dist/harness.d.ts",
                "import": "./dist/harness.js",
                "module": "./dist/harness.js"
            },
            "./javaArguments": {
                "types": "./dist/javaArguments.d.ts",
                "import": "./dist/javaArguments.js",
                "module": "./dist/javaArguments.js"
            },
            "./navigation/pathfinder": {
                "types": "./dist/navigation/pathfinder.d.ts",
                "import": "./dist/navigation/pathfinder.js",
                "module": "./dist/navigation/pathfinder.js"
            },
            "./navigation/profile": {
                "types": "./dist/navigation/profile.d.ts",
                "import": "./dist/navigation/profile.js",
                "module": "./dist/navigation/profile.js"
            },
            "./navigation/view": {
                "types": "./dist/navigation/view.d.ts",
                "import": "./dist/navigation/view.js",
                "module": "./dist/navigation/view.js"
            },
            "./navigation/voxelGrid": {
                "types": "./dist/navigation/voxelGrid.d.ts",
                "import": "./dist/navigation/voxelGrid.js",
                "module": "./dist/navigation/voxelGrid.js"
            },
            "./params": {
                "types": "./dist/params.d.ts",
                "import": "./dist/params.js",
                "module": "./dist/params.js"
            },
            "./register": {
                "types": "./dist/register.d.ts",
                "import": "./dist/register.js",
                "module": "./dist/register.js"
            },
            "./world": {
                "types": "./dist/world.d.ts",
                "import": "./dist/world.js",
                "module": "./dist/world.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./goals/dragonPhases": {
            "jsprismarine:dist": "./dist/goals/dragonPhases.js",
            "default": "./src/goals/dragonPhases.ts"
        },
        "./goals/mobAttacks": {
            "jsprismarine:dist": "./dist/goals/mobAttacks.js",
            "default": "./src/goals/mobAttacks.ts"
        },
        "./goals/shoulder": {
            "jsprismarine:dist": "./dist/goals/shoulder.js",
            "default": "./src/goals/shoulder.ts"
        },
        "./harness": {
            "jsprismarine:dist": "./dist/harness.js",
            "default": "./src/harness.ts"
        },
        "./javaArguments": {
            "jsprismarine:dist": "./dist/javaArguments.js",
            "default": "./src/javaArguments.ts"
        },
        "./navigation/pathfinder": {
            "jsprismarine:dist": "./dist/navigation/pathfinder.js",
            "default": "./src/navigation/pathfinder.ts"
        },
        "./navigation/profile": {
            "jsprismarine:dist": "./dist/navigation/profile.js",
            "default": "./src/navigation/profile.ts"
        },
        "./navigation/view": {
            "jsprismarine:dist": "./dist/navigation/view.js",
            "default": "./src/navigation/view.ts"
        },
        "./navigation/voxelGrid": {
            "jsprismarine:dist": "./dist/navigation/voxelGrid.js",
            "default": "./src/navigation/voxelGrid.ts"
        },
        "./params": {
            "jsprismarine:dist": "./dist/params.js",
            "default": "./src/params.ts"
        },
        "./register": {
            "jsprismarine:dist": "./dist/register.js",
            "default": "./src/register.ts"
        },
        "./world": {
            "jsprismarine:dist": "./dist/world.js",
            "default": "./src/world.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "bench": "node --expose-gc ../../scripts/run-ts.mjs benchmarks/pathSearch.bench.ts",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json",
        "inventory": "node utils/build-inventory.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "bedrock",
        "entities",
        "ai",
        "pathfinding"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/entity-goals",
    "dependencies": {
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/entities": "workspace:*",
        "@jsprismarine/errors": "workspace:*",
        "@jsprismarine/math": "workspace:*"
    },
    "devDependencies": {
        "@jsprismarine/packs": "workspace:*",
        "@types/node": "26.6.6",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    }
}
