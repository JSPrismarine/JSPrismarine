{
    "name": "@jsprismarine/entity-goals",
    "version": "0.18.0",
    "description": "The 170 vanilla Bedrock AI goals and the A* path finder they navigate with, written against the goal seam of @jsprismarine/entities",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.js",
                "module": "./dist/*.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./*": {
            "jsprismarine:dist": "./dist/*.js",
            "default": "./src/*.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "bench": "node --expose-gc ../../scripts/run-ts.mjs benchmarks/pathSearch.bench.ts",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json",
        "inventory": "node utils/build-inventory.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "bedrock",
        "entities",
        "ai",
        "pathfinding"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/entity-goals",
    "dependencies": {
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/entities": "workspace:*",
        "@jsprismarine/math": "workspace:*"
    },
    "devDependencies": {
        "@jsprismarine/packs": "workspace:*",
        "@types/node": "26.6.6",
        "glob": "14.0.4",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    }
}
