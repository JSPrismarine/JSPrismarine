{
    "name": "@jsprismarine/entity-brains",
    "version": "0.22.0",
    "description": "Java Edition's brain AI: memories, sensors, activities, behavior combinators and the twenty mobs that build a brain",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./memory": {
                "types": "./dist/memory.d.ts",
                "import": "./dist/memory.js",
                "module": "./dist/memory.js"
            },
            "./mobs/hoglin": {
                "types": "./dist/mobs/hoglin.d.ts",
                "import": "./dist/mobs/hoglin.js",
                "module": "./dist/mobs/hoglin.js"
            },
            "./mobs/piglin": {
                "types": "./dist/mobs/piglin.d.ts",
                "import": "./dist/mobs/piglin.js",
                "module": "./dist/mobs/piglin.js"
            },
            "./mobs/villager": {
                "types": "./dist/mobs/villager.d.ts",
                "import": "./dist/mobs/villager.js",
                "module": "./dist/mobs/villager.js"
            },
            "./mobs/warden": {
                "types": "./dist/mobs/warden.d.ts",
                "import": "./dist/mobs/warden.js",
                "module": "./dist/mobs/warden.js"
            },
            "./world": {
                "types": "./dist/world.d.ts",
                "import": "./dist/world.js",
                "module": "./dist/world.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./memory": {
            "jsprismarine:dist": "./dist/memory.js",
            "default": "./src/memory.ts"
        },
        "./mobs/hoglin": {
            "jsprismarine:dist": "./dist/mobs/hoglin.js",
            "default": "./src/mobs/hoglin.ts"
        },
        "./mobs/piglin": {
            "jsprismarine:dist": "./dist/mobs/piglin.js",
            "default": "./src/mobs/piglin.ts"
        },
        "./mobs/villager": {
            "jsprismarine:dist": "./dist/mobs/villager.js",
            "default": "./src/mobs/villager.ts"
        },
        "./mobs/warden": {
            "jsprismarine:dist": "./dist/mobs/warden.js",
            "default": "./src/mobs/warden.ts"
        },
        "./world": {
            "jsprismarine:dist": "./dist/world.js",
            "default": "./src/world.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "bedrock",
        "entities",
        "ai"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/entity-brains",
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "dependencies": {
        "@jsprismarine/errors": "workspace:*"
    }
}
