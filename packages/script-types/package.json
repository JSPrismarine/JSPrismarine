{
    "name": "@jsprismarine/script-types",
    "version": "0.22.0",
    "description": "TypeScript declarations for @jsprismarine/server, the JSPrismarine-only module behavior pack scripts import",
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist .turbo",
        "build": "node scripts/build.mts",
        "typecheck": "node scripts/build.mts && tsc-ts --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "minecraft",
        "bedrock",
        "scripting",
        "typescript",
        "types"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/script-types",
    "devDependencies": {
        "@jsprismarine/script-host": "workspace:*",
        "rimraf": "6.1.4",
        "typescript": "7.0.2"
    }
}
