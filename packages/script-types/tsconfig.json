{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    // The settings of a pack author's project: the built declarations and a script that uses them.
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": false,
        "types": []
    },
    "files": ["dist/index.d.ts", "test/pack.ts"]
}
