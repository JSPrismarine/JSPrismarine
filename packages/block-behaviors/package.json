{
    "name": "@jsprismarine/block-behaviors",
    "version": "0.25.0",
    "description": "The vanilla block behavior families, written against the BlockHooks seam and a WorldActions world interface",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./families/commandBlock": {
                "types": "./dist/families/commandBlock.d.ts",
                "import": "./dist/families/commandBlock.js",
                "module": "./dist/families/commandBlock.js"
            },
            "./rules/container": {
                "types": "./dist/rules/container.d.ts",
                "import": "./dist/rules/container.js",
                "module": "./dist/rules/container.js"
            },
            "./rules/fluid": {
                "types": "./dist/rules/fluid.d.ts",
                "import": "./dist/rules/fluid.js",
                "module": "./dist/rules/fluid.js"
            },
            "./rules/javaPlacement": {
                "types": "./dist/rules/javaPlacement.d.ts",
                "import": "./dist/rules/javaPlacement.js",
                "module": "./dist/rules/javaPlacement.js"
            },
            "./rules/piston": {
                "types": "./dist/rules/piston.d.ts",
                "import": "./dist/rules/piston.js",
                "module": "./dist/rules/piston.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./families/commandBlock": {
            "jsprismarine:dist": "./dist/families/commandBlock.js",
            "default": "./src/families/commandBlock.ts"
        },
        "./rules/container": {
            "jsprismarine:dist": "./dist/rules/container.js",
            "default": "./src/rules/container.ts"
        },
        "./rules/fluid": {
            "jsprismarine:dist": "./dist/rules/fluid.js",
            "default": "./src/rules/fluid.ts"
        },
        "./rules/javaPlacement": {
            "jsprismarine:dist": "./dist/rules/javaPlacement.js",
            "default": "./src/rules/javaPlacement.ts"
        },
        "./rules/piston": {
            "jsprismarine:dist": "./dist/rules/piston.js",
            "default": "./src/rules/piston.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "bedrock",
        "blocks",
        "behaviors"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/block-behaviors",
    "dependencies": {
        "@jsprismarine/blocks": "workspace:*",
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/errors": "workspace:*",
        "@jsprismarine/items": "workspace:*",
        "@jsprismarine/mapping": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "26.6.7",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    }
}
