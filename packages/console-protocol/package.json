{
    "name": "@jsprismarine/console-protocol",
    "version": "0.26.0",
    "description": "Message types and links between the JSPrismarine server and its console",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "typecheck": "tsc-ts --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "console",
        "protocol"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/console-protocol",
    "devDependencies": {
        "@types/node": "26.6.11",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.2"
    },
    "dependencies": {
        "@jsprismarine/errors": "workspace:*",
        "@jsprismarine/logger": "workspace:*"
    }
}
