{
    "name": "@jsprismarine/packs",
    "version": "0.15.2",
    "description": "Bedrock pack stack loader: directories, .mcpack/.mcaddon archives and brarchive layers composed into per-registry definitions.",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.es.js",
                "module": "./dist/index.es.js",
                "require": "./dist/index.cjs.cjs"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.es.js",
                "module": "./dist/*.es.js",
                "require": "./dist/*.cjs.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "main": "./dist/index.cjs.cjs",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "bedrock",
        "behavior-pack",
        "mcpack",
        "mcaddon"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/packs",
    "devDependencies": {
        "@types/node": "24.19.2",
        "glob": "13.0.6",
        "rimraf": "6.1.3",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "dependencies": {
        "@spyglassmc/core": "0.4.57",
        "@spyglassmc/java-edition": "0.3.70",
        "@spyglassmc/json": "0.3.61",
        "@spyglassmc/mcdoc": "0.3.61",
        "ajv": "8.20.0"
    }
}
