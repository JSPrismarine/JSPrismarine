{
    "name": "@jsprismarine/packs",
    "version": "0.22.0",
    "description": "Bedrock pack stack loader: directories, .mcpack/.mcaddon archives and brarchive layers composed into per-registry definitions.",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./brarchive": {
                "types": "./dist/brarchive.d.ts",
                "import": "./dist/brarchive.js",
                "module": "./dist/brarchive.js"
            },
            "./lenientJson": {
                "types": "./dist/lenientJson.d.ts",
                "import": "./dist/lenientJson.js",
                "module": "./dist/lenientJson.js"
            },
            "./manifest": {
                "types": "./dist/manifest.d.ts",
                "import": "./dist/manifest.js",
                "module": "./dist/manifest.js"
            },
            "./javaDataTarget": {
                "types": "./dist/javaDataTarget.d.ts",
                "import": "./dist/javaDataTarget.js",
                "module": "./dist/javaDataTarget.js"
            },
            "./mcdocValidator": {
                "types": "./dist/mcdocValidator.d.ts",
                "import": "./dist/mcdocValidator.js",
                "module": "./dist/mcdocValidator.js"
            },
            "./sources": {
                "types": "./dist/sources.d.ts",
                "import": "./dist/sources.js",
                "module": "./dist/sources.js"
            },
            "./zip": {
                "types": "./dist/zip.d.ts",
                "import": "./dist/zip.js",
                "module": "./dist/zip.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./brarchive": {
            "jsprismarine:dist": "./dist/brarchive.js",
            "default": "./src/brarchive.ts"
        },
        "./lenientJson": {
            "jsprismarine:dist": "./dist/lenientJson.js",
            "default": "./src/lenientJson.ts"
        },
        "./manifest": {
            "jsprismarine:dist": "./dist/manifest.js",
            "default": "./src/manifest.ts"
        },
        "./javaDataTarget": {
            "jsprismarine:dist": "./dist/javaDataTarget.js",
            "default": "./src/javaDataTarget.ts"
        },
        "./mcdocValidator": {
            "jsprismarine:dist": "./dist/mcdocValidator.js",
            "default": "./src/mcdocValidator.ts"
        },
        "./sources": {
            "jsprismarine:dist": "./dist/sources.js",
            "default": "./src/sources.ts"
        },
        "./zip": {
            "jsprismarine:dist": "./dist/zip.js",
            "default": "./src/zip.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "bench:path-addressed": "node benchmarks/pathAddressed.mjs",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "bedrock",
        "behavior-pack",
        "mcpack",
        "mcaddon"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/packs",
    "devDependencies": {
        "@spyglassmc/core": "0.4.58",
        "@spyglassmc/java-edition": "0.3.71",
        "@spyglassmc/json": "0.3.62",
        "@spyglassmc/mcdoc": "0.3.62",
        "@types/node": "26.6.6",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1",
        "vscode-languageserver-textdocument": "1.0.16"
    },
    "dependencies": {
        "@jsprismarine/errors": "workspace:*",
        "ajv": "8.20.0"
    },
    "peerDependencies": {
        "@spyglassmc/core": "0.4.58",
        "@spyglassmc/java-edition": "0.3.71",
        "@spyglassmc/json": "0.3.62",
        "@spyglassmc/mcdoc": "0.3.62",
        "vscode-languageserver-textdocument": "1.0.16"
    },
    "peerDependenciesMeta": {
        "@spyglassmc/core": {
            "optional": true
        },
        "@spyglassmc/java-edition": {
            "optional": true
        },
        "@spyglassmc/json": {
            "optional": true
        },
        "@spyglassmc/mcdoc": {
            "optional": true
        },
        "vscode-languageserver-textdocument": {
            "optional": true
        }
    }
}
