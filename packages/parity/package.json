{
    "name": "@jsprismarine/parity",
    "version": "0.18.0",
    "description": "The parity test suite: registry comparisons against the captured goldens, with a dashboard",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "clean": "rimraf dist *.tsbuildinfo .turbo",
        "test": "vitest run",
        "test:dist": "cross-env JSP_PARITY_USE_DIST=1 vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json",
        "dashboard": "node scripts/dashboard.ts",
        "comment:pr": "node scripts/post-pr-comment.ts",
        "capture:corpus": "node scripts/capture-corpus.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "parity"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/parity",
    "devDependencies": {
        "@jsprismarine/bedrock-data": "workspace:*",
        "@jsprismarine/binaryutils": "workspace:*",
        "@jsprismarine/block-behaviors": "workspace:*",
        "@jsprismarine/blocks": "workspace:*",
        "@jsprismarine/commands": "workspace:*",
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/entities": "workspace:*",
        "@jsprismarine/entity-brains": "workspace:*",
        "@jsprismarine/features": "workspace:*",
        "@jsprismarine/item-behaviors": "workspace:*",
        "@jsprismarine/items": "workspace:*",
        "@jsprismarine/loot": "workspace:*",
        "@jsprismarine/mapping": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*",
        "@jsprismarine/nbt": "workspace:*",
        "@jsprismarine/packs": "workspace:*",
        "@jsprismarine/prismarine": "workspace:*",
        "@jsprismarine/protocol": "workspace:*",
        "@jsprismarine/recipes": "workspace:*",
        "@jsprismarine/spawning": "workspace:*",
        "@jsprismarine/worldgen": "workspace:*",
        "@types/node": "26.6.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    }
}
