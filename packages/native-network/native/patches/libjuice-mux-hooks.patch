 static conn_mode_entry_t mode_entries[MODE_ENTRIES_SIZE] = {
     {conn_poll_registry_init, conn_poll_registry_cleanup, conn_poll_init, conn_poll_cleanup,
      conn_poll_lock, conn_poll_unlock, conn_poll_interrupt, conn_poll_send, conn_poll_tcp_connect, conn_poll_get_addrs,
-     NULL, NULL, NULL, MUTEX_INITIALIZER, NULL},
+     NULL, NULL, NULL, NULL, NULL, MUTEX_INITIALIZER, NULL},
     {conn_mux_registry_init, conn_mux_registry_cleanup, conn_mux_init, conn_mux_cleanup,
      conn_mux_lock, conn_mux_unlock, conn_mux_interrupt, conn_mux_send, NULL, conn_mux_get_addrs,
-     conn_mux_listen, conn_mux_get_registry, conn_mux_can_release_registry, MUTEX_INITIALIZER, NULL},
+     conn_mux_listen, conn_mux_set_hooks, conn_mux_sendto, conn_mux_get_registry,
+     conn_mux_can_release_registry, MUTEX_INITIALIZER, NULL},
     {NULL, NULL, conn_thread_init, conn_thread_cleanup,
      conn_thread_lock, conn_thread_unlock, conn_thread_interrupt, conn_thread_send, NULL, conn_thread_get_addrs,
-     NULL, NULL, NULL, MUTEX_INITIALIZER, NULL}
+     NULL, NULL, NULL, NULL, NULL, MUTEX_INITIALIZER, NULL}
 };
 
 static conn_mode_entry_t *get_mode_entry(juice_concurrency_mode_t mode) {
@@ -311,3 +312,64 @@ int juice_mux_listen(const char *bind_address, int local_port, juice_cb_mux_inco
 	mutex_unlock(&entry->mutex);
 	return 0;
 }
+
+int juice_mux_set_hooks(const char *bind_address, int local_port, const juice_mux_hooks_t *hooks) {
+	conn_mode_entry_t *entry = &mode_entries[JUICE_CONCURRENCY_MODE_MUX];
+	if (!entry->mux_set_hooks_func || !entry->get_registry_func)
+		return -1;
+
+	mutex_lock(&entry->mutex);
+
+	udp_socket_config_t config;
+	memset(&config, 0, sizeof(config));
+	config.bind_address = bind_address;
+	config.port_begin = config.port_end = (uint16_t)local_port;
+
+	conn_registry_t *registry;
+	if (hooks) {
+		// locks the registry, creating it first if required
+		if (acquire_registry(entry, &config, &registry) || !registry) {
+			JLOG_WARN("juice_mux_set_hooks could not bind port %d", local_port);
+			mutex_unlock(&entry->mutex);
+			return -1;
+		}
+	} else {
+		registry = entry->get_registry_func(&config);
+		if (!registry) {
+			mutex_unlock(&entry->mutex);
+			return 0;
+		}
+		mutex_lock(&registry->mutex);
+	}
+
+	int ret = entry->mux_set_hooks_func(registry, hooks);
+	release_registry(entry, registry); // unlocks the registry
+	mutex_unlock(&entry->mutex);
+	return ret;
+}
+
+int juice_mux_sendto(int local_port, const char *data, size_t size, const void *dst_addr,
+                     size_t dst_addr_len) {
+	conn_mode_entry_t *entry = &mode_entries[JUICE_CONCURRENCY_MODE_MUX];
+	if (!entry->mux_sendto_func || !entry->get_registry_func)
+		return -1;
+
+	if (dst_addr_len > sizeof(struct sockaddr_storage))
+		return -1;
+
+	addr_record_t dst;
+	memset(&dst, 0, sizeof(dst));
+	memcpy(&dst.addr, dst_addr, dst_addr_len);
+	dst.len = (socklen_t)dst_addr_len;
+	dst.socktype = SOCK_DGRAM;
+
+	udp_socket_config_t config;
+	memset(&config, 0, sizeof(config));
+	config.port_begin = config.port_end = (uint16_t)local_port;
+
+	mutex_lock(&entry->mutex);
+	conn_registry_t *registry = entry->get_registry_func(&config);
+	int ret = registry ? entry->mux_sendto_func(registry, data, size, &dst) : -1;
+	mutex_unlock(&entry->mutex);
+	return ret;
+}
