+			registry_impl_t *hooks_impl = registry->impl;
+			if (hooks_impl->has_hooks && hooks_impl->hooks.filter &&
+			    hooks_impl->hooks.filter(buffer, (size_t)ret, &src.addr, (size_t)src.len,
