diff --git a/include/juice/juice.h b/include/juice/juice.h
index e43db6c..f69738a 100644
--- a/include/juice/juice.h
+++ b/include/juice/juice.h
@@ -77,6 +77,22 @@ typedef struct juice_mux_binding_request {
 
 typedef void (*juice_cb_mux_incoming_t)(const juice_mux_binding_request_t *info, void *user_ptr);
 
+// Sees every datagram the mux socket receives, before the mux looks up its agent. The address is
+// a struct sockaddr, with an IPv4-mapped IPv6 address unmapped. Returns nonzero to take the
+// datagram, which the mux then drops; zero lets the mux handle it as usual.
+typedef int (*juice_cb_mux_filter_t)(const char *data, size_t size, const void *src_addr,
+                                     size_t src_addr_len, void *user_ptr);
+
+// Receives each datagram the filter let through and no agent claimed.
+typedef void (*juice_cb_mux_unhandled_t)(const char *data, size_t size, const void *src_addr,
+                                         size_t src_addr_len, void *user_ptr);
+
+typedef struct juice_mux_hooks {
+	juice_cb_mux_filter_t filter;       // optional
+	juice_cb_mux_unhandled_t unhandled; // optional
+	void *user_ptr;
+} juice_mux_hooks_t;
+
 typedef struct juice_turn_server {
 	const char *host;
 	const char *username;
@@ -137,6 +153,13 @@ JUICE_EXPORT int juice_get_selected_addresses(juice_agent_t *agent, char *local,
 JUICE_EXPORT int juice_set_local_ice_attributes(juice_agent_t *agent, const char *ufrag, const char *pwd);
 JUICE_EXPORT const char *juice_state_to_string(juice_state_t state);
 JUICE_EXPORT int juice_mux_listen(const char *bind_address, int local_port, juice_cb_mux_incoming_t cb, void *user_ptr);
+// Binds the mux socket for local_port, creating it if needed, and keeps it open while hooks are
+// set, even with no agent on it. NULL hooks remove them, and the socket closes with its last agent.
+JUICE_EXPORT int juice_mux_set_hooks(const char *bind_address, int local_port,
+                                     const juice_mux_hooks_t *hooks);
+// Sends a datagram from the mux socket bound on local_port to a struct sockaddr.
+JUICE_EXPORT int juice_mux_sendto(int local_port, const char *data, size_t size,
+                                  const void *dst_addr, size_t dst_addr_len);
 JUICE_EXPORT int juice_set_ice_tcp_mode(juice_agent_t *agent, juice_ice_tcp_mode_t ice_tcp_mode);
 
