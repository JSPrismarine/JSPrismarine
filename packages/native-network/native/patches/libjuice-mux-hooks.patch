@@ -699,5 +715,36 @@ bool conn_mux_can_release_registry(conn_registry_t *registry) {
 		return true;
 	}
 
-	return registry_impl->cb_mux_incoming == NULL;
+	return registry_impl->cb_mux_incoming == NULL && !registry_impl->has_hooks;
+}
+
+int conn_mux_set_hooks(conn_registry_t *registry, const juice_mux_hooks_t *hooks) {
+	// registry must be locked
+	registry_impl_t *registry_impl = registry->impl;
+	if (!registry_impl)
+		return -1;
+
+	if (hooks) {
+		registry_impl->hooks = *hooks;
+		registry_impl->has_hooks = true;
+		return 0;
+	}
+
+	memset(&registry_impl->hooks, 0, sizeof(registry_impl->hooks));
+	registry_impl->has_hooks = false;
+	return conn_mux_interrupt_registry(registry);
+}
+
+int conn_mux_sendto(conn_registry_t *registry, const char *data, size_t size,
+                    const addr_record_t *dst) {
+	registry_impl_t *registry_impl = registry->impl;
+	if (!registry_impl)
+		return -1;
+
+	mutex_lock(&registry_impl->send_mutex);
+	int ret = udp_sendto(registry_impl->sock, data, size, dst);
+	if (ret < 0)
+		ret = -sockerrno;
+	mutex_unlock(&registry_impl->send_mutex);
+	return ret;
 }
