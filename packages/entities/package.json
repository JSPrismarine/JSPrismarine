    "type": "module",
    "files": [
        "dist",
        "vanilla_overlay",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./attributes": {
            "jsprismarine:dist": "./dist/attributes.js",
