            "jsprismarine:dist": "./dist/entityInstance.js",
            "default": "./src/entityInstance.ts"
        },
        "./entityType": {
            "jsprismarine:dist": "./dist/entityType.js",
            "default": "./src/entityType.ts"
        },
        "./eventEngine": {
            "jsprismarine:dist": "./dist/eventEngine.js",
            "default": "./src/eventEngine.ts"
        },
        "./events": {
            "jsprismarine:dist": "./dist/events.js",
            "default": "./src/events.ts"
        },
        "./filterContext": {
            "jsprismarine:dist": "./dist/filterContext.js",
