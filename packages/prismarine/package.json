{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@jsprismarine/prismarine",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.es.js",
                "module": "./dist/index.es.js"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.es.js",
                "module": "./dist/*.es.js"
            },
            "./world/positionKeys": null,
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "version": "0.16.0",
    "description": "Dedicated Minecraft Bedrock Edition server written in TypeScript",
    "prettier": "@nordcom/prettier",
    "files": [
        "dist",
        "schemas",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.es.js",
            "default": "./src/index.ts"
        },
        "./*": {
            "jsprismarine:dist": "./dist/*.es.js",
            "default": "./src/*.ts"
        },
        "./world/positionKeys": null,
        "./package.json": "./package.json"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/prismarine",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "generate": "node utils/generate-schemas.mjs",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "bench:compile-cache": "node --import tsx benchmarks/compileCache.ts",
        "bench:startup": "node --import tsx benchmarks/compileCache.ts --startup-only",
        "bench:chunks": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/chunkGeneration.ts",
        "bench:chunks:source": "node --import tsx benchmarks/runExternal.mjs benchmarks/chunkGeneration.ts",
        "bench:chunks:dist": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/chunkGeneration.ts",
        "bench:full-flush-fragments": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/fullFlushFragments.bench.ts",
        "bench:entity-ai": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/entityAi.bench.ts",
        "bench:entity-ai:source": "node --import tsx benchmarks/runExternal.mjs benchmarks/entityAi.bench.ts",
        "bench:entity-ai:dist": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/entityAi.bench.ts",
        "bench:entity-ai-digest": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/entityAiDigest.bench.ts",
        "bench:entity-ai-digest:source": "node --import tsx benchmarks/runExternal.mjs benchmarks/entityAiDigest.bench.ts",
        "bench:entity-ai-digest:dist": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/entityAiDigest.bench.ts",
        "bench:chunk-delivery": "node --import tsx benchmarks/playerChunkDelivery.ts --cached",
        "bench:commands": "node benchmarks/run.mjs benchmarks/commandTree.bench.ts",
        "bench:ticker": "node benchmarks/run.mjs benchmarks/tickerCatchup.bench.ts",
        "bench:gc-tuning": "node benchmarks/gcTuning.mjs",
        "bench:inbound-latency": "node benchmarks/run.mjs benchmarks/inboundLatency.bench.ts",
        "bench:session-outbound": "node benchmarks/run.mjs benchmarks/sessionOutbound.bench.ts",
        "bench:network": "node benchmarks/run.mjs benchmarks/blockProximity.bench.ts",
        "bench:movement-idle": "node benchmarks/run.mjs benchmarks/idleMovement.bench.ts",
        "bench:client-cache": "node --import tsx benchmarks/clientBlobCache.ts",
        "bench:chunk-batches": "node --import tsx benchmarks/chunkBatchCache.ts",
        "bench:light-chunk-load": "node --import tsx benchmarks/lightChunkLoad.ts",
        "bench:world-save": "node --import tsx benchmarks/worldSave.ts",
        "bench:entity-only-save": "node --import tsx benchmarks/entityOnlyChunkSave.ts",
        "bench:chunk-reads": "node --import tsx benchmarks/chunkReads.bench.ts",
        "bench:inbound-frame": "node --import tsx benchmarks/inboundFrameOverhead.bench.ts",
        "bench:packet-batch": "node --import tsx benchmarks/packetBatch.bench.mjs",
        "bench:world-keys": "node benchmarks/run.mjs benchmarks/worldMapKeys.bench.ts",
        "bench:block-hot-paths": "node benchmarks/run.mjs benchmarks/blockHotPaths.bench.ts",
        "bench:block-entity-write": "node benchmarks/run.mjs benchmarks/blockEntityWrite.bench.ts",
        "bench:join-burst": "node benchmarks/run.mjs benchmarks/joinBurst.bench.ts",
        "bench:bot-fleet": "pnpm -w run build && node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/botFleetLoad.bench.ts",
        "bench:bot-fleet:gate": "pnpm -w run build && node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/botFleetLoad.bench.ts --baseline benchmarks/botFleetLoad.baseline.json",
        "bench:bot-fleet:baseline": "pnpm -w run build && node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/botFleetLoad.bench.ts --update-baseline benchmarks/botFleetLoad.baseline.json",
        "bench:movement-fanout": "node benchmarks/run.mjs benchmarks/entityMovementFanout.bench.ts",
        "bench:entity-movement-delta": "node benchmarks/run.mjs benchmarks/entityMovementDelta.bench.ts",
        "bench:entity-movement-fanout": "node benchmarks/run.mjs benchmarks/entityMovementFanout.bench.ts",
        "bench:runtime-id-fanout": "node benchmarks/run.mjs benchmarks/runtimeIdFanout.bench.ts",
        "bench:items": "node benchmarks/run.mjs benchmarks/entityPickup.bench.ts",
        "bench:inbound-packets": "node --import tsx benchmarks/inboundPacketRecording.bench.ts",
        "bench:recipes": "node benchmarks/run.mjs benchmarks/recipes.bench.ts",
        "bench:breeding-navigation": "node benchmarks/run.mjs benchmarks/breedingNavigation.bench.ts",
        "bench:trends": "node benchmarks/trends.mjs",
        "bench:storage": "node benchmarks/run.mjs benchmarks/blockStorage.bench.ts",
        "bench:feature-worker": "node --expose-gc benchmarks/run.mjs benchmarks/featureWorker.bench.ts",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json",
        "prepack": "pnpm run generate"
    },
    "keywords": [
        "javascript",
        "typescript",
        "minecraft",
        "mcpe",
        "bedrock",
        "be"
    ],
    "author": "JSPrismarine",
    "license": "MPL-2.0",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "@types/terminal-kit": "2.5.7",
        "ajv": "8.20.0",
        "fast-jwt": "6.3.6",
        "glob": "13.0.6",
        "rimraf": "6.1.3",
        "ts-json-schema-generator": "2.9.0",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.1.0"
    },
    "dependencies": {
        "@jsprismarine/advancements": "workspace:*",
        "@jsprismarine/bedrock-data": "workspace:*",
        "@jsprismarine/binaryutils": "workspace:*",
        "@jsprismarine/block-behaviors": "workspace:*",
        "@jsprismarine/blocks": "workspace:*",
        "@jsprismarine/brigadier": "workspace:*",
        "@jsprismarine/chunkgen": "workspace:*",
        "@jsprismarine/color-parser": "workspace:*",
        "@jsprismarine/commands": "workspace:*",
        "@jsprismarine/console-protocol": "workspace:*",
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/enchantments": "workspace:*",
        "@jsprismarine/engine-systems": "workspace:*",
        "@jsprismarine/entities": "workspace:*",
        "@jsprismarine/entity-brains": "workspace:*",
        "@jsprismarine/entity-goals": "workspace:*",
        "@jsprismarine/errors": "workspace:*",
        "@jsprismarine/features": "workspace:*",
        "@jsprismarine/item-behaviors": "workspace:*",
        "@jsprismarine/items": "workspace:*",
        "@jsprismarine/kernel": "workspace:*",
        "@jsprismarine/leveldb": "workspace:*",
        "@jsprismarine/lighting": "workspace:*",
        "@jsprismarine/logger": "workspace:*",
        "@jsprismarine/loot": "workspace:*",
        "@jsprismarine/mapping": "workspace:*",
        "@jsprismarine/math": "workspace:*",
        "@jsprismarine/mcfunction": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*",
        "@jsprismarine/nbt": "workspace:*",
        "@jsprismarine/packs": "workspace:*",
        "@jsprismarine/predicates": "workspace:*",
        "@jsprismarine/protocol": "workspace:*",
        "@jsprismarine/raknet": "workspace:*",
        "@jsprismarine/recipes": "workspace:*",
        "@jsprismarine/spawning": "workspace:*",
        "@jsprismarine/structures": "workspace:*",
        "@jsprismarine/trading": "workspace:*",
        "@jsprismarine/worldgen": "workspace:*",
        "jsonc-parser": "3.3.1"
    }
}
