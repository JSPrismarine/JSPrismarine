        "bench:block-state-allocation": "node --expose-gc --import tsx benchmarks/blockStateAllocation.mts",
        "bench:chunks": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/chunkGeneration.ts",
        "bench:chunks:dist": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/chunkGeneration.ts",
        "bench:terrain-cache": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/terrainProtoCache.ts",
        "bench:template-decode": "node --import tsx benchmarks/templateDecodeAcrossWorkers.bench.ts",
