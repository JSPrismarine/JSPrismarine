        "bench:entity-ai": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/entityAi.bench.ts",
        "bench:entity-ai:dist": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/entityAi.bench.ts",
        "bench:entity-ai-digest": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/entityAiDigest.bench.ts",
        "bench:entity-ai-digest:dist": "node --conditions=jsprismarine:dist benchmarks/runExternal.mjs benchmarks/entityAiDigest.bench.ts",
        "bench:chunk-delivery": "node benchmarks/run.mjs benchmarks/playerChunkDelivery.ts --cached",
        "bench:commands": "node benchmarks/run.mjs benchmarks/commandTree.bench.ts",
        "bench:ticker": "node benchmarks/run.mjs benchmarks/tickerCatchup.bench.ts",
        "bench:gc-tuning": "node benchmarks/gcTuning.mjs",
        "bench:inbound-latency": "node benchmarks/run.mjs benchmarks/inboundLatency.bench.ts",
        "bench:session-outbound": "node benchmarks/run.mjs benchmarks/sessionOutbound.bench.ts",
        "bench:network": "node benchmarks/run.mjs benchmarks/blockProximity.bench.ts",
        "bench:movement-idle": "node benchmarks/run.mjs benchmarks/idleMovement.bench.ts",
