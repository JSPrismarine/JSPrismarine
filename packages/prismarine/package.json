{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@jsprismarine/prismarine",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.es.js",
                "module": "./dist/index.es.js",
                "require": "./dist/index.cjs.cjs"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.es.js",
                "module": "./dist/*.es.js",
                "require": "./dist/*.cjs.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "version": "0.15.2",
    "description": "Dedicated Minecraft Bedrock Edition server written in TypeScript",
    "prettier": "@nordcom/prettier",
    "files": [
        "dist",
        "schemas",
        "CHANGELOG.md",
        "README.md"
    ],
    "main": "./dist/index.cjs.cjs",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./package.json": "./package.json"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/prismarine",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "generate": "node utils/generate-schemas.cjs",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "typecheck": "tsc-ts --noEmit",
        "prepack": "pnpm run generate"
    },
    "keywords": [
        "javascript",
        "typescript",
        "minecraft",
        "mcpe",
        "bedrock",
        "be"
    ],
    "author": "JSPrismarine",
    "license": "MPL-2.0",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "@types/terminal-kit": "2.5.7",
        "ajv": "8.20.0",
        "fast-jwt": "6.3.5",
        "glob": "13.0.6",
        "rimraf": "6.1.3",
        "ts-json-schema-generator": "2.9.0",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "dependencies": {
        "@jsprismarine/advancements": "workspace:*",
        "@jsprismarine/binaryutils": "workspace:*",
        "@jsprismarine/block-behaviors": "workspace:*",
        "@jsprismarine/blocks": "workspace:*",
        "@jsprismarine/color-parser": "workspace:*",
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/enchantments": "workspace:*",
        "@jsprismarine/engine-systems": "workspace:*",
        "@jsprismarine/entities": "workspace:*",
        "@jsprismarine/entity-brains": "workspace:*",
        "@jsprismarine/entity-goals": "workspace:*",
        "@jsprismarine/errors": "workspace:*",
        "@jsprismarine/features": "workspace:*",
        "@jsprismarine/item-behaviors": "workspace:*",
        "@jsprismarine/items": "workspace:*",
        "@jsprismarine/leveldb": "workspace:*",
        "@jsprismarine/lighting": "workspace:*",
        "@jsprismarine/logger": "workspace:*",
        "@jsprismarine/loot": "workspace:*",
        "@jsprismarine/mapping": "workspace:*",
        "@jsprismarine/math": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*",
        "@jsprismarine/nbt": "workspace:*",
        "@jsprismarine/packs": "workspace:*",
        "@jsprismarine/predicates": "workspace:*",
        "@jsprismarine/protocol": "workspace:*",
        "@jsprismarine/raknet": "workspace:*",
        "@jsprismarine/recipes": "workspace:*",
        "@jsprismarine/spawning": "workspace:*",
        "@jsprismarine/structures": "workspace:*",
        "@jsprismarine/trading": "workspace:*",
        "@jsprismarine/wire": "workspace:*",
        "@jsprismarine/worldgen": "workspace:*",
        "jsonc-parser": "3.3.1",
        "yaml": "2.9.1"
    }
}
