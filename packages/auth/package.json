{
    "name": "@jsprismarine/auth",
    "version": "0.26.0",
    "description": "Minecraft: Bedrock Edition login identity, for both ends: offline and Xbox Live providers for a client, and login verification for a server",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./IAuthProvider": {
                "types": "./dist/IAuthProvider.d.ts",
                "import": "./dist/IAuthProvider.js",
                "module": "./dist/IAuthProvider.js"
            },
            "./client": {
                "types": "./dist/client.d.ts",
                "import": "./dist/client.js",
                "module": "./dist/client.js"
            },
            "./protocol": {
                "types": "./dist/protocol.d.ts",
                "import": "./dist/protocol.js",
                "module": "./dist/protocol.js"
            },
            "./server": {
                "types": "./dist/server.d.ts",
                "import": "./dist/server.js",
                "module": "./dist/server.js"
            },
            "./DefaultSkin": {
                "types": "./dist/DefaultSkin.d.ts",
                "import": "./dist/DefaultSkin.js",
                "module": "./dist/DefaultSkin.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./IAuthProvider": {
            "jsprismarine:dist": "./dist/IAuthProvider.js",
            "default": "./src/IAuthProvider.ts"
        },
        "./client": {
            "jsprismarine:dist": "./dist/client.js",
            "default": "./src/client.ts"
        },
        "./protocol": {
            "jsprismarine:dist": "./dist/protocol.js",
            "default": "./src/protocol.ts"
        },
        "./server": {
            "jsprismarine:dist": "./dist/server.js",
            "default": "./src/server.ts"
        },
        "./DefaultSkin": {
            "jsprismarine:dist": "./dist/DefaultSkin.js",
            "default": "./src/DefaultSkin.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "minecraft",
        "bedrock",
        "authentication",
        "xbox"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/auth",
    "devDependencies": {
        "@types/node": "26.6.11",
        "glob": "14.0.6",
        "prismarine-auth": "3.1.1",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.2"
    },
    "dependencies": {
        "@jsprismarine/errors": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*",
        "jose": "6.2.18"
    },
    "peerDependencies": {
        "prismarine-auth": "^3.1.1"
    },
    "peerDependenciesMeta": {
        "prismarine-auth": {
            "optional": true
        }
    }
}
