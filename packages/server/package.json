{
    "name": "@jsprismarine/server",
    "version": "0.18.0",
    "description": "Minecraft: Bedrock Edition dedicated server entrypoint",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "import": "./dist/index.js",
                "module": "./dist/index.js",
                "types": "./dist/index.d.ts"
            },
            "./*": {
                "import": "./dist/*.js",
                "module": "./dist/*.js",
                "types": "./dist/*.d.ts"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "bin": {
        "prismarine": "./dist/index.js"
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./*": {
            "jsprismarine:dist": "./dist/*.js",
            "default": "./src/*.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "typecheck": "tsc-ts --noEmit",
        "bench:startup": "node benchmarks/startup.mjs",
        "bench:host-startup": "node benchmarks/hostStartup.mjs",
        "start": "pnpm --filter @jsprismarine/server... run build && cross-env NODE_ENV=production node --conditions=jsprismarine:dist --unhandled-rejections=strict ./dist/Server.js",
        "dev": "pnpm --filter @jsprismarine/bedrock-data run ensure:worldgen && pnpm --filter @jsprismarine/bedrock-data run ensure:bedrock-pack && pnpm -w run server:build && node scripts/dev.mjs",
        "dev:native-prototype": "cross-env NODE_ENV=development node --import ./scripts/native-typescript-loader.mjs ./src/Server.ts --watch",
        "bench:native-typescript": "node ./scripts/native-typescript-benchmark.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "nodejs",
        "jsprismarine",
        "server",
        "bedrock"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/server",
    "devDependencies": {
        "@types/node": "26.6.6",
        "@types/yargs": "17.0.35",
        "cross-env": "10.1.0",
        "glob": "14.0.4",
        "rimraf": "6.1.4",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    },
    "dependencies": {
        "@jsprismarine/color-parser": "workspace:*",
        "@jsprismarine/console-protocol": "workspace:*",
        "@jsprismarine/logger": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*",
        "@jsprismarine/packs": "workspace:*",
        "@jsprismarine/prismarine": "workspace:*",
        "@jsprismarine/raknet": "workspace:*",
        "yargs": "18.2.0"
    },
    "optionalDependencies": {
        "@jsprismarine/console": "workspace:*"
    }
}
