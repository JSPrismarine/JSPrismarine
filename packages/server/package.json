{
    "name": "@jsprismarine/server",
    "version": "0.14.2",
    "description": "Minecraft: Bedrock Edition dedicated server entrypoint",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "import": "./dist/index.es.js",
                "module": "./dist/index.es.js",
                "types": "./dist/index.d.ts"
            },
            "./*": {
                "import": "./dist/*.es.js",
                "module": "./dist/*.es.js",
                "types": "./dist/*.d.ts"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "bin": {
        "prismarine": "./dist/index.es.js"
    },
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "typecheck": "tsc-ts --noEmit",
        "start": "cross-env NODE_ENV=production node --unhandled-rejections=strict --import tsx ./src/Server.ts",
        "dev": "cross-env NODE_ENV=development node ./scripts/dev.mts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "nodejs",
        "jsprismarine",
        "server",
        "bedrock"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/server",
    "devDependencies": {
        "@types/node": "24.13.6",
        "@types/yargs": "17.0.35",
        "cross-env": "10.1.0",
        "glob": "13.0.6",
        "rimraf": "6.1.3",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.3",
        "vitest": "5.0.1"
    },
    "dependencies": {
        "@jsprismarine/color-parser": "workspace:*",
        "@jsprismarine/logger": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*",
        "@jsprismarine/prismarine": "workspace:*",
        "@jsprismarine/raknet": "workspace:*",
        "yargs": "17.7.3"
    }
}
