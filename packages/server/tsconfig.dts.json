{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "incremental": false,
        "inlineSourceMap": false,
        "paths": {
            "@jsprismarine/*": ["../*/dist/index.d.ts"]
        }
    },
    "include": ["src/**/*", "src/**/*.json"],
    "exclude": ["src/**/*.test.*", "src/**/__fixtures__/**"]
}
