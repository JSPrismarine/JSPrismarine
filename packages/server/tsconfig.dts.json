{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "incremental": false,
        "inlineSourceMap": false,
        "paths": {
            // Keep subpath imports on dist declarations instead of mixing in their source graph.
            // The root is `Server.ts`, so it has no `index.d.ts`.
            "@jsprismarine/prismarine": ["../prismarine/dist/Server.d.ts"],
            "@jsprismarine/prismarine/*": ["../prismarine/dist/*.d.ts"],
            "@jsprismarine/*": ["../*/dist/index.d.ts"]
        }
    },
    "include": ["src/**/*", "src/**/*.json"],
    "exclude": ["src/**/*.test.*", "src/**/__fixtures__/**"]
}
