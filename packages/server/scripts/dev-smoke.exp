#!/usr/bin/expect -f
# Smoke test for the dev supervisor's console: the interactive stdin must keep
# working across watch restarts. This is exactly what `node --watch` broke
# (stdin went dead after the first restart), so run this after touching
# scripts/dev.mjs or the console/readline handling in @jsprismarine/prismarine.
#
# Needs `expect` and a real PTY (run it from a terminal):
#     expect packages/server/scripts/dev-smoke.exp
#
# It boots the real server on the configured port, so stop any other local
# instance first. Prints SMOKE PASS and exits 0 on success; exits 1 on the
# first step that does not behave.

set timeout 120
cd [file join [file dirname [info script]] ..]

proc fail {step} {
    send_user "\nSMOKE FAIL: $step\n"
    exec pkill -f {./src/Server.ts}
    exit 1
}

proc await {pattern step} {
    expect {
        -re $pattern {}
        timeout { fail $step }
        eof { fail "$step (supervisor exited)" }
    }
}

proc command_works {name step} {
    sleep 2
    send "$name\r"
    await {issued server command} $step
}

spawn node ./scripts/dev.mts
await {listening on port} "initial boot"
command_works version "console input on first boot"

exec touch ../prismarine/src/Console.ts
await {restarting} "restart on a change in another package"
await {listening on port} "reboot after restart"
command_works version "console input after a restart"

exec touch ./src/Server.ts
await {restarting} "restart on a change in the server package"
await {listening on port} "reboot after second restart"
command_works help "console input after a second restart"

send "stop\r"
await {Goodbye} "graceful stop from the console"
if {[lindex [wait] 3] != 0} { fail "supervisor exit code" }

send_user "\nSMOKE PASS\n"
exit 0
