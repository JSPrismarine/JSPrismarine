{
    "name": "@jsprismarine/native-library",
    "version": "0.26.0",
    "description": "Finds, verifies and installs the prebuilt native libraries JSPrismarine's packages load",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/NativeLibrary.d.ts",
                "import": "./dist/NativeLibrary.js",
                "module": "./dist/NativeLibrary.js"
            },
            "./manifest": {
                "types": "./dist/manifest.d.ts",
                "import": "./dist/manifest.js",
                "module": "./dist/manifest.js"
            },
            "./nativeHash": {
                "types": "./dist/nativeHash.d.ts",
                "import": "./dist/nativeHash.js",
                "module": "./dist/nativeHash.js"
            },
            "./platform": {
                "types": "./dist/platform.d.ts",
                "import": "./dist/platform.js",
                "module": "./dist/platform.js"
            },
            "./ffi": {
                "types": "./dist/ffi.d.ts",
                "import": "./dist/ffi.js",
                "module": "./dist/ffi.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/NativeLibrary.js",
    "types": "./dist/NativeLibrary.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/NativeLibrary.js",
            "default": "./src/NativeLibrary.ts"
        },
        "./manifest": {
            "jsprismarine:dist": "./dist/manifest.js",
            "default": "./src/manifest.ts"
        },
        "./nativeHash": {
            "jsprismarine:dist": "./dist/nativeHash.js",
            "default": "./src/nativeHash.ts"
        },
        "./platform": {
            "jsprismarine:dist": "./dist/platform.js",
            "default": "./src/platform.ts"
        },
        "./ffi": {
            "jsprismarine:dist": "./dist/ffi.js",
            "default": "./src/ffi.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "native",
        "ffi",
        "prebuilds"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/native-library",
    "devDependencies": {
        "@types/node": "26.6.7",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "dependencies": {
        "@jsprismarine/errors": "workspace:*"
    }
}
