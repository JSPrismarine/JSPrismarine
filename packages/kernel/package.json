{
    "name": "@jsprismarine/kernel",
    "version": "0.25.0",
    "description": "Module kernel: lifecycle, a token-keyed service registry, and the event bus that modules plug into",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./testing": {
                "types": "./dist/testing.d.ts",
                "import": "./dist/testing.js",
                "module": "./dist/testing.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./testing": {
            "jsprismarine:dist": "./dist/testing.js",
            "default": "./src/testing.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "kernel",
        "modules"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/kernel",
    "devDependencies": {
        "@types/node": "26.6.7",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "dependencies": {
        "@jsprismarine/errors": "workspace:*"
    }
}
