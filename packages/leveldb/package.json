{
    "name": "@jsprismarine/leveldb",
    "version": "0.26.0",
    "description": "LevelDB reader/writer for Minecraft: Bedrock Edition worlds, in pure TypeScript",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./db/Storage": {
                "types": "./dist/db/Storage.d.ts",
                "import": "./dist/db/Storage.js",
                "module": "./dist/db/Storage.js"
            },
            "./format/InternalKey": {
                "types": "./dist/format/InternalKey.d.ts",
                "import": "./dist/format/InternalKey.js",
                "module": "./dist/format/InternalKey.js"
            },
            "./format/TableReader": {
                "types": "./dist/format/TableReader.d.ts",
                "import": "./dist/format/TableReader.js",
                "module": "./dist/format/TableReader.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./db/Storage": {
            "jsprismarine:dist": "./dist/db/Storage.js",
            "default": "./src/db/Storage.ts"
        },
        "./format/InternalKey": {
            "jsprismarine:dist": "./dist/format/InternalKey.js",
            "default": "./src/format/InternalKey.ts"
        },
        "./format/TableReader": {
            "jsprismarine:dist": "./dist/format/TableReader.js",
            "default": "./src/format/TableReader.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "bench:block-cache": "pnpm run build && node benchmarks/blockCache.bench.mjs",
        "bench:compaction": "pnpm run build && node benchmarks/compaction.bench.mjs",
        "typecheck": "tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "minecraft",
        "bedrock",
        "leveldb",
        "mcpe"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/leveldb",
    "devDependencies": {
        "@types/node": "26.6.11",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.4.0",
        "vitest": "5.1.2"
    },
    "dependencies": {
        "@jsprismarine/errors": "workspace:*"
    }
}
