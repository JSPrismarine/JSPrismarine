{
    "name": "@jsprismarine/blocks",
    "version": "0.23.0",
    "description": "The Bedrock block definition grammar, component runtime, permutation evaluation, state model and the jsprismarine_vanilla overlay pack",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./components": {
                "types": "./dist/components.d.ts",
                "import": "./dist/components.js",
                "module": "./dist/components.js"
            },
            "./geometry": {
                "types": "./dist/geometry.d.ts",
                "import": "./dist/geometry.js",
                "module": "./dist/geometry.js"
            },
            "./hooks": {
                "types": "./dist/hooks.d.ts",
                "import": "./dist/hooks.js",
                "module": "./dist/hooks.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "vanilla_overlay",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./components": {
            "jsprismarine:dist": "./dist/components.js",
            "default": "./src/components.ts"
        },
        "./geometry": {
            "jsprismarine:dist": "./dist/geometry.js",
            "default": "./src/geometry.ts"
        },
        "./hooks": {
            "jsprismarine:dist": "./dist/hooks.js",
            "default": "./src/hooks.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "generate:block-tags": "node utils/generate-block-tags.mjs",
        "generate:display-names": "node utils/generate-display-names.mjs",
        "generate:liquid-reactions": "vite build && node utils/generate-liquid-reactions.mjs",
        "generate:overlay": "pnpm run generate:display-names && turbo run build --filter=@jsprismarine/blocks && node --conditions=jsprismarine:dist utils/generate-overlay.mjs",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "bedrock",
        "blocks",
        "components"
    ],
    "author": "JSPrismarine",
    "license": "(MIT OR MPL-2.0)",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/blocks",
    "dependencies": {
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/errors": "workspace:*",
        "@jsprismarine/mapping": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*",
        "@jsprismarine/molang": "workspace:*",
        "@jsprismarine/packs": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    }
}
