{
    "name": "@jsprismarine/blocks",
    "version": "0.19.2",
    "description": "The Bedrock block definition grammar, component runtime, permutation evaluation, state model and the jsprismarine_vanilla overlay pack",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.js",
                "module": "./dist/*.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "vanilla_overlay",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./*": {
            "jsprismarine:dist": "./dist/*.js",
            "default": "./src/*.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "generate:block-tags": "node utils/generate-block-tags.mjs",
        "generate:display-names": "pnpm --filter @jsprismarine/bedrock-data run fetch:cloudburst && node utils/generate-display-names.mjs",
        "generate:geometry": "pnpm --filter @jsprismarine/bedrock-data run fetch:cloudburst && node utils/generate-geometry.mjs",
        "generate:overlay": "pnpm run generate:display-names && pnpm run generate:geometry && vite build && node utils/generate-overlay.mjs",
        "test": "vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "minecraft",
        "bedrock",
        "blocks",
        "components"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/blocks",
    "dependencies": {
        "@jsprismarine/content": "workspace:*",
        "@jsprismarine/mapping": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*",
        "@jsprismarine/molang": "workspace:*",
        "@jsprismarine/packs": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.4",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.7",
        "vitest": "5.1.0"
    }
}
