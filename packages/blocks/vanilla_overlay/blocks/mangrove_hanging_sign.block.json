{
    "format_version": "1.26.20",
    "minecraft:block": {
        "description": {
            "identifier": "minecraft:mangrove_hanging_sign"
        },
        "components": {
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 1
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 1
            },
            "minecraft:friction": 0.6,
            "minecraft:light_emission": 0,
            "minecraft:light_dampening": 0,
            "minecraft:movable": {
                "movement_type": "push_pull"
            },
            "minecraft:display_name": "tile.mangrove_hanging_sign.name",
            "minecraft:collision_box": {
                "origin": [-2, 14, -8],
                "size": [4, 2, 16]
            },
            "jsprismarine:behavior": "jsprismarine:sign",
            "jsprismarine:block_properties": {
                "friction": 0.6,
                "random_tick": false,
                "requires_correct_tool": false,
                "push_reaction": "push_pull",
                "source": "java"
            }
        },
        "permutations": [
            {
                "condition": "query.block_state('hanging') == 1",
                "components": {
                    "minecraft:collision_box": false
                }
            },
            {
                "condition": "((query.block_state('facing_direction') == 2 || query.block_state('facing_direction') == 3)) && (query.block_state('hanging') == 0)",
                "components": {
                    "minecraft:collision_box": {
                        "origin": [-8, 14, -2],
                        "size": [16, 2, 4]
                    }
                }
            }
        ]
    }
}
