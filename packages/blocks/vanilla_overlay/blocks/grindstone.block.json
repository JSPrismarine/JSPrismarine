{
    "format_version": "1.26.20",
    "minecraft:block": {
        "description": {
            "identifier": "minecraft:grindstone"
        },
        "components": {
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 2
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 6
            },
            "minecraft:friction": 0.6,
            "minecraft:light_emission": 0,
            "minecraft:light_dampening": 0,
            "minecraft:movable": {
                "movement_type": "immovable"
            },
            "minecraft:display_name": "tile.grindstone.name",
            "minecraft:collision_box": {
                "origin": [-6, 0, -6],
                "size": [12, 16, 12]
            },
            "jsprismarine:behavior": "jsprismarine:utility",
            "jsprismarine:block_properties": {
                "friction": 0.6,
                "random_tick": false,
                "requires_correct_tool": true,
                "push_reaction": "immovable",
                "source": "java"
            }
        },
        "permutations": [
            {
                "condition": "(query.block_state('attachment') == 'side') && ((query.block_state('direction') == 0 || query.block_state('direction') == 2))",
                "components": {
                    "minecraft:collision_box": {
                        "origin": [-6, 2, -8],
                        "size": [12, 12, 16]
                    }
                }
            },
            {
                "condition": "(query.block_state('attachment') == 'side') && ((query.block_state('direction') == 1 || query.block_state('direction') == 3))",
                "components": {
                    "minecraft:collision_box": {
                        "origin": [-8, 2, -6],
                        "size": [16, 12, 12]
                    }
                }
            }
        ]
    }
}
