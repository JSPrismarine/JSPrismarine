                    "minecraft:collision_box": {
                        "origin": [-4, 4, -8],
                        "size": [8, 12, 16]
                    }
                }
            },
            {
                "condition": "(query.block_state('attachment') == 'multiple') && ((query.block_state('direction') == 1 || query.block_state('direction') == 3))",
                "components": {
                    "minecraft:collision_box": {
                        "origin": [-8, 4, -4],
