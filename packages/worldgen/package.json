{
    "name": "@jsprismarine/worldgen",
    "version": "0.20.0",
    "description": "Java Edition terrain generation: randoms, noise, density functions, aquifers and chunk sampling",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.js",
                "module": "./dist/*.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./*": {
            "jsprismarine:dist": "./dist/*.js",
            "default": "./src/*.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "bench": "node benchmarks/run.mts",
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "bench:climate": "node benchmarks/runBiomeClimate.mts",
        "bench:climate-search": "node benchmarks/runClimateSearch.mts",
        "bench:density-volume": "node benchmarks/runDensityVolume.mts",
        "bench:interpolated-cell": "node benchmarks/runInterpolatedCell.mts",
        "bench:biome-manager": "node benchmarks/runBiomeManager.mts",
        "test": "pnpm --filter @jsprismarine/bedrock-data run ensure:java-server && vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json",
        "vectors": "pnpm --filter @jsprismarine/bedrock-data run ensure:java-server && node utils/oracle/run.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "worldgen",
        "minecraft",
        "noise",
        "density-function"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/worldgen",
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.4",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.0"
    }
}
