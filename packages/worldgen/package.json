{
    "name": "@jsprismarine/worldgen",
    "version": "0.22.0",
    "description": "Java Edition terrain generation: randoms, noise, density functions, aquifers and chunk sampling",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "module": "./dist/index.js"
            },
            "./biome/BiomeSource": {
                "types": "./dist/biome/BiomeSource.d.ts",
                "import": "./dist/biome/BiomeSource.js",
                "module": "./dist/biome/BiomeSource.js"
            },
            "./blending/Blender": {
                "types": "./dist/blending/Blender.d.ts",
                "import": "./dist/blending/Blender.js",
                "module": "./dist/blending/Blender.js"
            },
            "./blending/BlendingData": {
                "types": "./dist/blending/BlendingData.d.ts",
                "import": "./dist/blending/BlendingData.js",
                "module": "./dist/blending/BlendingData.js"
            },
            "./blending/belowZeroRetrogen": {
                "types": "./dist/blending/belowZeroRetrogen.d.ts",
                "import": "./dist/blending/belowZeroRetrogen.js",
                "module": "./dist/blending/belowZeroRetrogen.js"
            },
            "./blending/generationVersion": {
                "types": "./dist/blending/generationVersion.d.ts",
                "import": "./dist/blending/generationVersion.js",
                "module": "./dist/blending/generationVersion.js"
            },
            "./chunk/Aquifer": {
                "types": "./dist/chunk/Aquifer.d.ts",
                "import": "./dist/chunk/Aquifer.js",
                "module": "./dist/chunk/Aquifer.js"
            },
            "./random/LegacyRandomSource": {
                "types": "./dist/random/LegacyRandomSource.d.ts",
                "import": "./dist/random/LegacyRandomSource.js",
                "module": "./dist/random/LegacyRandomSource.js"
            },
            "./surface/SurfaceSystem": {
                "types": "./dist/surface/SurfaceSystem.d.ts",
                "import": "./dist/surface/SurfaceSystem.js",
                "module": "./dist/surface/SurfaceSystem.js"
            },
            "./package.json": "./package.json"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "jsprismarine:dist": "./dist/index.js",
            "default": "./src/index.ts"
        },
        "./biome/BiomeSource": {
            "jsprismarine:dist": "./dist/biome/BiomeSource.js",
            "default": "./src/biome/BiomeSource.ts"
        },
        "./blending/Blender": {
            "jsprismarine:dist": "./dist/blending/Blender.js",
            "default": "./src/blending/Blender.ts"
        },
        "./blending/BlendingData": {
            "jsprismarine:dist": "./dist/blending/BlendingData.js",
            "default": "./src/blending/BlendingData.ts"
        },
        "./blending/belowZeroRetrogen": {
            "jsprismarine:dist": "./dist/blending/belowZeroRetrogen.js",
            "default": "./src/blending/belowZeroRetrogen.ts"
        },
        "./blending/generationVersion": {
            "jsprismarine:dist": "./dist/blending/generationVersion.js",
            "default": "./src/blending/generationVersion.ts"
        },
        "./chunk/Aquifer": {
            "jsprismarine:dist": "./dist/chunk/Aquifer.js",
            "default": "./src/chunk/Aquifer.ts"
        },
        "./random/LegacyRandomSource": {
            "jsprismarine:dist": "./dist/random/LegacyRandomSource.js",
            "default": "./src/random/LegacyRandomSource.ts"
        },
        "./surface/SurfaceSystem": {
            "jsprismarine:dist": "./dist/surface/SurfaceSystem.js",
            "default": "./src/surface/SurfaceSystem.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "bench": "node benchmarks/run.mts",
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "bench:climate": "node benchmarks/runBiomeClimate.mts",
        "bench:climate-search": "node benchmarks/runClimateSearch.mts",
        "bench:density-volume": "node benchmarks/runDensityVolume.mts",
        "bench:interpolated-cell": "node benchmarks/runInterpolatedCell.mts",
        "bench:biome-manager": "node benchmarks/runBiomeManager.mts",
        "test": "pnpm --filter @jsprismarine/bedrock-data run ensure:java-server && vitest run",
        "typecheck": "tsc-ts --noEmit && tsc-ts --noEmit -p tsconfig.test.json",
        "vectors": "pnpm --filter @jsprismarine/bedrock-data run ensure:java-server && node utils/oracle/run.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "jsprismarine",
        "worldgen",
        "minecraft",
        "noise",
        "density-function"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/worldgen",
    "devDependencies": {
        "@types/node": "26.6.6",
        "glob": "14.0.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "dependencies": {
        "@jsprismarine/errors": "workspace:*"
    }
}
