{
    "extends": "./tsconfig.build.json",

    "compilerOptions": {
        "noEmit": true,

        // Parity and console-protocol import workspace sources directly with `.ts` extensions,
        // and this aggregate project includes their source and test files.
        "allowImportingTsExtensions": true
    },

    "exclude": ["**/*.config.*", "**/*.stories.*"]
}
