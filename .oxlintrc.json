{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [],
    "categories": {
        "correctness": "off",
        "suspicious": "off",
        "pedantic": "off",
        "perf": "off",
        "style": "off",
        "restriction": "off",
        "nursery": "off"
    },
    "jsPlugins": [{ "name": "landmines", "specifier": "@interfere/landmines" }],
    "rules": {
        "landmines/no-fixed-sleep": "error",
        "landmines/no-flake-masking": "error",
        "landmines/no-test-doubles": "error",
        "landmines/no-unsignaled-poll": "error",
        "landmines/strict-msw": "error",
        "landmines/colocated-tests": "error",
        "landmines/package-exports": "error",
        "landmines/test-file-names": "error"
    },
    "ignorePatterns": [
        "**/dist/**",
        "**/coverage/**",
        "packages/bedrock-data/src/generated/**",
        "packages/bedrock-data/src/jsp/**",
        "packages/minecraft/src/generated/**"
    ]
}
