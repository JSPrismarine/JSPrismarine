{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    // The compiler settings every addon's scripts share. Each addon's tsconfig.json extends this and
    // names its own folders, since a path here would resolve against this folder.
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        // Sources import each other as `./bar.ts`, which the output names `./bar.js`, so Node.js and
        // Vitest can load a source module directly, as the docs build does.
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "noEmitOnError": true,
        // For the debugger: the maps stay beside the scripts, and the pack leaves them out.
        "sourceMap": true,
        "types": ["@jsprismarine/script-types"]
    },
    "files": ["globals.d.ts"]
}
