{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "scripts"
    },
    "include": ["src"],
    // The tests run under Vitest from the sources, and stay out of the pack.
    "exclude": ["src/**/*.test.ts"]
}
