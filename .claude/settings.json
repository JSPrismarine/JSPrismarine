{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-lint-gate.mts\"",
                        "timeout": 300
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-lint-gate.mts\"",
                        "timeout": 300
                    }
                ]
            }
        ]
    }
}
