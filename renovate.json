{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["local>NordcomInc/renovate-config", ":semanticCommits", ":automergeMajor"],
    "commitMessageAction": "update",
    "packageRules": [
        {
            "matchManagers": ["github-actions"],
            "commitMessageTopic": "{{{depName}}}"
        },
        {
            "matchManagers": ["dockerfile"],
            "matchUpdateTypes": ["digest"],
            "commitMessageTopic": "{{{depName}}} digest"
        },
        {
            "description": "Keep Blacksmith actions on their major tag instead of pinning a commit digest",
            "matchManagers": ["github-actions"],
            "matchPackageNames": ["useblacksmith/**"],
            "pinDigests": false
        }
    ]
}
