# Node.js things
node_modules/
yarn.lock
coverage/
junit.xml
.vitest/

# JSPrismarine things
dist/
/plugins/
/builds/
/worlds/
config.yaml
ops.json
banned-players.json
permissions.json
# A parity scenario's config/ holds fixtures, not a server's permissions.
!/packages/parity/scenarios/*/config/**/permissions.json
nethernet-identity.pem
server-uuid.txt
*.log
/logs/
/jsp/
/packages/prismarine/schemas/

# Build
.tsup
vite.config.ts.timestamp*
*.bun-build

# Tests
/.vitest/json

# Turbo cache
.turbo/

# Text editors/IDE things
.idea
.DS_Store
report.*.json
*.cpuprofile
.tsbuildinfo
*.tsbuildinfo

# Generated site output
assets/
*.html
# The brand's logo and icon files are checked in; the pattern above is for build output.
!/docs/brand/assets/


# Pinned upstream sources for datagen. Committed on purpose: Mojang keeps only a rolling
# window of documentation branches, so this is the only copy that will exist once the branch
# it came from is deleted.
!packages/*/datagen/snapshot/**

# Generated by the documentation build.
tools/docs/site/api/
tools/docs/site/addons/
tools/docs/site/guide/
tools/docs/site/errors/
tools/docs/site/brand/
tools/docs/site/contributing.md
tools/docs/site/code-of-conduct.md
tools/docs/site/data-driven/
tools/docs/site/adr/
tools/docs/site/plans/
tools/docs/site/research/
tools/docs/site/public/parity-tracker/
tools/docs/site/public/repo/
tools/docs/site/public/addon-media/
tools/docs/site/public/search-index.json
tools/docs/site/public/moved-errors.json
# Rasterized from docs/brand/assets/ by `brand-assets-cli.mts site` on every docs build.
tools/docs/site/public/favicon.*
tools/docs/site/public/apple-touch-icon.png
tools/docs/site/public/icon-*.png
tools/docs/site/public/site.webmanifest
tools/docs/site/.vitepress/dist/
tools/docs/site/.vitepress/cache/
tools/docs/site/.vitepress/.temp/

# Local environment overrides the server loads from its working directory; never shared.
.env.local
.env.*.local
/packages/*/jsp/

# Java bundler extraction from the worldgen and data generator oracles
/libraries/
/versions/
packages/bedrock-data/src/jsp/v*/packets/

# Temporary bundles written by scripts/run-ts.mjs
.jsp-run-*/
vitest-report.json

# Addon scripts, which tsc-ts builds from each addon's src/.
/addons/*/scripts/
