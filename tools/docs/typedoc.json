{
    "$schema": "https://typedoc.org/schema.json",
    "name": "JSPrismarine",
    "plugin": [
        "typedoc-plugin-markdown",
        "typedoc-vitepress-theme",
        "typedoc-plugin-merge-modules",
        "typedoc-plugin-rename-defaults"
    ],
    "entryPoints": ["../../packages/*"],
    "entryPointStrategy": "packages",
    "tsconfig": "../../tsconfig.json",
    "out": "./site/api",
    "docsRoot": "./site",
    "readme": "none",
    "excludeExternals": true,
    "excludeInternal": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "externalPattern": ["**/node_modules/**"],
    "exclude": ["**/node_modules/**"],
    "mergeModulesRenameDefaults": true,
    "mergeModulesMergeMode": "module",
    "blockTags": [
        "@alpha",
        "@beta",
        "@category",
        "@categoryDescription",
        "@class",
        "@constant",
        "@default",
        "@defaultValue",
        "@deprecated",
        "@document",
        "@enum",
        "@event",
        "@eventProperty",
        "@example",
        "@experimental",
        "@function",
        "@group",
        "@groupDescription",
        "@hidden",
        "@ignore",
        "@inheritDoc",
        "@inheritdoc",
        "@interface",
        "@internal",
        "@license",
        "@member",
        "@memberof",
        "@method",
        "@module",
        "@namespace",
        "@override",
        "@overload",
        "@package",
        "@param",
        "@private",
        "@privateRemarks",
        "@property",
        "@protected",
        "@public",
        "@readonly",
        "@remarks",
        "@returns",
        "@sealed",
        "@see",
        "@since",
        "@static",
        "@template",
        "@throws",
        "@todo",
        "@type",
        "@typedef",
        "@typeParam",
        "@virtual"
    ]
}
