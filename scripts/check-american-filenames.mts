    'minim',
    'general',
    'emphas',
    'critic',
    'visual',
    'normal',
    'apolog',
    'synchron',
    'random'
]) {
    for (const suffix of ['ise', 'ises', 'ised', 'ising', 'isation', 'isations']) {
        spellings.add(`${stem}${suffix}`);
    }
}

const paths = execFileSync('git', ['ls-files', '--cached', '--others', '--exclude-standard', '-z'], {
    encoding: 'utf8'
})
    .split('\0')
    .filter((path) => path.length > 0 && existsSync(path));

const matches = paths.flatMap((path) => {
    const words = path
        .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
        .replace(/[^a-zA-Z0-9]+/g, ' ')
        .toLowerCase()
        .split(/\s+/);
    return words.some((word) => spellings.has(word)) ? [path] : [];
});

if (matches.length > 0) {
    console.error('Use American English spelling in file and folder names:');
    for (const path of matches) console.error(`  ${path}`);
    process.exitCode = 1;
}
