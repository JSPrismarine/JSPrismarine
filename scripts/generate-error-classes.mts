/**
 * Writes the error classes of `@jsprismarine/errors` from its catalogs.
 *
 * Each catalog under `packages/errors/catalog/` declares its errors with `defineErrors`: a key, a
 * message template, an optional base and a JSDoc description per entry. This script reads those
 * declarations from the source text and writes the module of the same path under
 * `packages/errors/src/`, which is what the package publishes. There every entry is an ordinary
 * class declaration, so an ahead-of-time compiler can lower it, and the catalog object maps each key
 * to its class. Everything else in a catalog, such as its category classes, is copied unchanged.
 *
 * `--check` writes nothing and fails when a generated module differs from what the catalogs make,
 * so an edit to a catalog that was not regenerated, or an edit to a generated module, fails the lint.
 */

import { existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

import * as prettier from 'prettier';
import type {
    CallExpression,
    ClassDeclaration,
    EnumDeclaration,
    FunctionDeclaration,
    ImportDeclaration,
    InterfaceDeclaration,
    Node,
    ObjectLiteralExpression,
    PropertyAssignment,
    SourceFile,
    StringLiteral,
    TypeAliasDeclaration,
    VariableStatement
} from 'tsc-ts/api';
import { forEachChild, getJSDoc, getTextOfNode, parseSourceFile, SyntaxKind } from 'tsc-ts/api';

import { constantCase, docsUrlOf } from '../packages/errors/src/JSPrismarineError.ts';

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const packageDir = path.join(repoRoot, 'packages', 'errors');

/** Where the hand-written catalogs live. */
export const CATALOG_DIR = path.join(packageDir, 'catalog');
/** Where the generated modules go, one per catalog at the same relative path. */
export const OUTPUT_DIR = path.join(packageDir, 'src');

/** The module that declares `defineErrors`, which a generated module does not import. */
const DEFINE_ERRORS_MODULE = 'defineErrors';
/** The module that defines the catalog roots. */
const ROOT_MODULE = '@jsprismarine/errors/JSPrismarineError';
/**
 * The first line of every generated module. The generator deletes a module under `src/` whose
 * catalog is gone only when it starts with this line, so it never removes a file written by hand.
 */
const GENERATED_HEADER = '// Generated by scripts/generate-error-classes.mts';

/** The root each built-in base becomes, so every catalog error has a root it can be tested by. */
const ROOTS: Readonly<Record<string, string>> = {
    Error: 'JSPrismarineError',
    TypeError: 'JSPrismarineTypeError',
    RangeError: 'JSPrismarineRangeError',
    ReferenceError: 'JSPrismarineReferenceError'
};

/** Globals a generated class body refers to, which no entry may shadow. */
const GLOBALS = new Set(['Object', 'String', 'ErrorOptions', ...Object.keys(ROOTS), ...Object.values(ROOTS)]);

const PLACEHOLDER = /\{(\w+)\}/g;
/**
 * Every `{...}` in a template, read the way `Placeholders` in `catalog/defineErrors.ts` reads it:
 * from a `{` to the next `}`. The generator accepts only the ones that are also a {@link PLACEHOLDER}.
 */
const BRACED = /\{([^}]*)\}/g;
const IDENTIFIER = /^[A-Za-z_$][\w$]*$/;

/** One entry of a catalog, as the generated class needs it. */
interface Entry {
    readonly key: string;
    readonly template: string;
    /** The identifier of the class the entry extends, after built-in bases became their roots. */
    readonly base: string;
    /** The entry's JSDoc comment, unindented, or an empty string. */
    readonly doc: string;
}

// The API's `Node` is the base interface and ships no `is*` helpers, so narrowing goes by `kind`.
const isImport = (node: Node): node is ImportDeclaration => node.kind === SyntaxKind.ImportDeclaration;
const isVariableStatement = (node: Node): node is VariableStatement => node.kind === SyntaxKind.VariableStatement;
const isNamedDeclaration = (
    node: Node
): node is ClassDeclaration | FunctionDeclaration | InterfaceDeclaration | TypeAliasDeclaration | EnumDeclaration =>
    node.kind === SyntaxKind.ClassDeclaration ||
    node.kind === SyntaxKind.FunctionDeclaration ||
    node.kind === SyntaxKind.InterfaceDeclaration ||
    node.kind === SyntaxKind.TypeAliasDeclaration ||
    node.kind === SyntaxKind.EnumDeclaration;
const isCall = (node: Node): node is CallExpression => node.kind === SyntaxKind.CallExpression;
const isObject = (node: Node): node is ObjectLiteralExpression => node.kind === SyntaxKind.ObjectLiteralExpression;
const isProperty = (node: Node): node is PropertyAssignment => node.kind === SyntaxKind.PropertyAssignment;
const isString = (node: Node): node is StringLiteral =>
    node.kind === SyntaxKind.StringLiteral || node.kind === SyntaxKind.NoSubstitutionTemplateLiteral;

/** A failure that names the catalog file and what in it the generator cannot read. */
const fail = (file: string, message: string): never => {
    throw new Error(`packages/errors/catalog/${file}: ${message}`);
};

/** The source text of a node with its leading comments, as written. */
const fullText = (text: string, node: Node) => text.slice(node.pos, node.end).trim();

/** A JSDoc comment at the top level, whatever its indentation in the catalog. */
const unindentDoc = (comment: string) =>
    comment
        .trim()
        .split('\n')
        .map((line, index) => (index === 0 ? line : ` ${line.trimStart()}`))
        .join('\n');

/** Every identifier a node refers to, outside its comments. */
const identifiersIn = (node: Node, into: Set<string>): Set<string> => {
    if (node.kind === SyntaxKind.Identifier) into.add(getTextOfNode(node));
    forEachChild(node, (child) => {
        identifiersIn(child, into);
    });
    return into;
};

/**
 * The names a top-level statement binds, as a value or a type, which a generated class must not
 * take. A destructuring declaration counts every identifier in its pattern.
 */
const declaredBy = (statement: Node): string[] => {
    if (isVariableStatement(statement)) {
        const names = new Set<string>();
        for (const declaration of statement.declarationList.declarations.nodes) identifiersIn(declaration.name, names);
        return [...names];
    }
    if (isNamedDeclaration(statement) && statement.name) return [getTextOfNode(statement.name)];
    return [];
};

/** The `defineErrors(...)` call a statement declares its catalog with, if it does. */
const catalogCall = (statement: Node): { name: string; call: CallExpression } | undefined => {
    if (!isVariableStatement(statement)) return undefined;
    const [declaration] = statement.declarationList.declarations.nodes;
    const initializer = declaration?.initializer;
    if (!declaration || !initializer || !isCall(initializer)) return undefined;
    if (getTextOfNode(initializer.expression) !== 'defineErrors') return undefined;
    return { name: getTextOfNode(declaration.name), call: initializer };
};

/** Fails unless every `{...}` in an entry's template is a placeholder the generated class can fill. */
const checkPlaceholders = (file: string, key: string, template: string) => {
    for (const [braced, name = ''] of template.matchAll(BRACED)) {
        if (!/^\w+$/.test(name)) {
            fail(file, `${key} has ${braced} in its message; a placeholder name uses only letters, digits and _`);
        }
    }
};

/**
 * The class an entry names as its base. A built-in error becomes its catalog root, unless the
 * catalog binds that name itself, as `import { ContentError as RangeError }` would.
 */
const baseOf = (base: string, locals: ReadonlySet<string>) => (locals.has(base) ? base : (ROOTS[base] ?? base));

/**
 * The entries of a `defineErrors` object, in the order the catalog lists them. `locals` holds the
 * names the catalog imports or declares.
 */
const readEntries = (
    file: string,
    text: string,
    entries: ObjectLiteralExpression,
    locals: ReadonlySet<string>
): Entry[] =>
    entries.properties.nodes.map((property) => {
        if (!isProperty(property)) return fail(file, `${getTextOfNode(property)} is not a \`key: entry\` property`);
        const key = getTextOfNode(property.name);
        if (!IDENTIFIER.test(key)) return fail(file, `the key ${key} is not an identifier, so it cannot name a class`);
        const doc = getJSDoc(property)
            .map((comment) => unindentDoc(fullText(text, comment)))
            .join('\n');
        const value = property.initializer;
        if (isString(value)) {
            checkPlaceholders(file, key, value.text);
            return { key, template: value.text, base: ROOTS.Error!, doc };
        }
        if (!isObject(value)) return fail(file, `${key} is neither a message nor a { message, base } entry`);

        let template: string | undefined;
        // An entry that names no base extends the global `Error`, whatever the catalog binds.
        let base: string | undefined;
        for (const field of value.properties.nodes) {
            if (!isProperty(field)) return fail(file, `${key} has a field that is not a \`name: value\` property`);
            const name = getTextOfNode(field.name);
            if (name === 'message' && isString(field.initializer)) template = field.initializer.text;
            else if (name === 'base' && field.initializer.kind === SyntaxKind.Identifier)
                base = getTextOfNode(field.initializer);
            else fail(file, `${key}.${name} must be a string message or a base class named by an identifier`);
        }
        if (template === undefined) return fail(file, `${key} has no message`);
        checkPlaceholders(file, key, template);
        return { key, template, base: base === undefined ? ROOTS.Error! : baseOf(base, locals), doc };
    });

/** The placeholder names of a template, each once, in the order they first appear. */
const placeholdersOf = (template: string) => [...new Set([...template.matchAll(PLACEHOLDER)].map(([, name]) => name!))];

/** A property name in generated code: bare when it is an identifier, quoted otherwise. */
const propertyName = (name: string) => (IDENTIFIER.test(name) ? name : JSON.stringify(name));

/** The expression that builds an entry's message from its `params`, as a template literal would. */
const messageExpression = (template: string) => {
    if (placeholdersOf(template).length === 0) return JSON.stringify(template);
    // A raw carriage return in a template literal reads as a line feed, so it is written escaped.
    const escape = (part: string) =>
        part.replaceAll('\\', '\\\\').replaceAll('`', '\\`').replaceAll('${', '\\${').replaceAll('\r', '\\r');
    const body = template
        .split(PLACEHOLDER)
        .map((part, index) => {
            if (index % 2 === 0) return escape(part);
            // `?.` builds the message when a JavaScript caller passes null or undefined for the params.
            return `\${String(${IDENTIFIER.test(part) ? `params?.${part}` : `params?.[${JSON.stringify(part)}]`})}`;
        })
        .join('');
    return `\`${body}\``;
};

/** The class an entry becomes. */
const classOf = (entry: Entry, domain: string, module: string | undefined) => {
    const code = `${constantCase(domain)}_${constantCase(entry.key)}`;
    const docs = docsUrlOf(domain, code, module);
    const placeholders = placeholdersOf(entry.template);
    const paramsType = `{ ${placeholders.map((name) => `readonly ${propertyName(name)}: unknown`).join('; ')} }`;
    // What the constructor stores when a JavaScript caller passes null or undefined for the params.
    const missingParams = `{ ${placeholders.map((name) => `${propertyName(name)}: undefined`).join(', ')} }`;
    const takesParams = placeholders.length > 0;
    const lines: (string | undefined)[] = [
        entry.doc || undefined,
        `class ${entry.key} extends ${entry.base} {`,
        `public static readonly code = ${JSON.stringify(code)};`,
        `public static readonly domain = ${JSON.stringify(domain)};`,
        module === undefined ? undefined : `public static readonly module = ${JSON.stringify(module)};`,
        `public static readonly template = ${JSON.stringify(entry.template)};`,
        `public static readonly docs = ${JSON.stringify(docs)};`,
        '',
        `public override readonly code = ${JSON.stringify(code)};`,
        `public override readonly docs = ${JSON.stringify(docs)};`,
        // The named values, which a reader can also look up by any string key, as on the root.
        `readonly #params: ${takesParams ? `${paramsType} & ` : ''}Readonly<Record<string, unknown>>${takesParams ? '' : ' = {}'};`,
        '',
        `public constructor(${takesParams ? `params: ${paramsType}, ` : ''}options?: ErrorOptions) {`,
        `super(${messageExpression(entry.template)}, options);`,
        takesParams ? `this.#params = params ?? ${missingParams};` : undefined,
        '}',
        '',
        '/** The placeholder values the message was built from. */',
        'public override get params() {',
        'return this.#params;',
        '}',
        '}'
    ];
    return lines.filter((line) => line !== undefined).join('\n');
};

/** One name a catalog imports. */
interface ImportBinding {
    readonly module: string;
    /** The specifier as written, such as `type A`, `A as B` or `A`. */
    readonly text: string;
    /** The name the catalog's code refers to it by. */
    readonly local: string;
    readonly typeOnly: boolean;
}

/** The names a catalog imports, except `defineErrors`. */
const readImports = (file: string, imports: readonly ImportDeclaration[]): ImportBinding[] =>
    imports.flatMap((declaration) => {
        const specifier = declaration.moduleSpecifier;
        if (!isString(specifier)) return fail(file, 'an import names its module with something other than a string');
        if (path.posix.basename(specifier.text) === DEFINE_ERRORS_MODULE) return [];
        const bindings = declaration.importClause?.namedBindings;
        if (
            !declaration.importClause ||
            declaration.importClause.name ||
            declaration.importClause.phaseModifier !== undefined ||
            bindings?.kind !== SyntaxKind.NamedImports
        ) {
            return fail(file, `the import from ${specifier.text} must be a plain \`import { ... }\``);
        }
        return bindings.elements.nodes.map((element) => ({
            module: specifier.text,
            text: getTextOfNode(element),
            local: getTextOfNode(element.name),
            typeOnly: element.isTypeOnly
        }));
    });

/**
 * The import declarations a generated module needs: the catalog's own, trimmed to the names it
 * uses, and the roots its classes extend.
 */
const importsOf = (file: string, bindings: readonly ImportBinding[], used: ReadonlySet<string>) => {
    const kept = bindings.filter(({ local }) => used.has(local));
    for (const root of Object.values(ROOTS).filter((name) => used.has(name))) {
        const existing = kept.find(({ local }) => local === root);
        if (existing && existing.module !== ROOT_MODULE) {
            fail(
                file,
                `${root} is imported from ${existing.module}, but the generated classes extend the catalog root`
            );
        }
        if (existing && !existing.typeOnly) continue;
        if (existing) kept.splice(kept.indexOf(existing), 1);
        kept.push({ module: ROOT_MODULE, text: root, local: root, typeOnly: false });
    }

    const modules = new Map<string, string[]>();
    for (const { module, text } of kept) modules.set(module, [...(modules.get(module) ?? []), text]);
    return [...modules]
        .map(([module, names]) => `import { ${names.join(', ')} } from ${JSON.stringify(module)};`)
        .join('\n');
};

/**
 * The generated module for one catalog, before formatting. `file` is the catalog's path under
 * `packages/errors/catalog/`, such as `prismarine/world.ts`, which must match the catalog name it
 * passes to `defineErrors`.
 */
export const generateCatalogModule = (file: string, text: string): string => {
    const source: SourceFile = parseSourceFile(file, text, {});
    const statements = source.statements.nodes;
    const imports = statements.filter(isImport);

    const bindings = readImports(file, imports);
    // Every name the catalog binds outside its `defineErrors` call, which no entry may take.
    const declared = new Set<string>();
    for (const statement of statements) {
        if (!isImport(statement) && !catalogCall(statement))
            for (const name of declaredBy(statement)) declared.add(name);
    }
    const locals = new Set([...declared, ...bindings.map(({ local }) => local)]);
    for (const { local } of bindings) {
        if (declared.has(local)) fail(file, `${local} is both imported and declared`);
    }

    const body: string[] = [];
    const used = new Set<string>();
    let catalogs = 0;
    for (const statement of statements) {
        if (isImport(statement)) continue;
        const found = catalogCall(statement);
        if (!found) {
            body.push(fullText(text, statement));
            identifiersIn(statement, used);
            continue;
        }
        catalogs++;
        const [nameArgument, entriesArgument] = found.call.arguments.nodes;
        if (!nameArgument || !isString(nameArgument) || !entriesArgument || !isObject(entriesArgument)) {
            return fail(file, `${found.name} must be declared as defineErrors('<catalog>', { ... })`);
        }
        const catalog = nameArgument.text;
        if (catalog !== file.replace(/\.ts$/, '').split(path.sep).join('/')) {
            return fail(file, `defineErrors('${catalog}') must name the catalog after its file`);
        }
        const [domain = catalog, module] = catalog.split('/');
        const entries = readEntries(file, text, entriesArgument, locals);
        for (const entry of entries) {
            used.add(entry.base);
            if (GLOBALS.has(entry.key)) fail(file, `the key ${entry.key} would shadow ${entry.key} in its class`);
            if (locals.has(entry.key) || entry.key === found.name) {
                fail(file, `the key ${entry.key} is also the name of a declaration or an import in the catalog`);
            }
        }

        const doc = getJSDoc(statement)
            .map((comment) => fullText(text, comment))
            .join('\n');
        body.push(
            ...entries.map((entry) => classOf(entry, domain, module)),
            `${doc}\nexport const ${found.name} = Object.freeze({ ${entries.map(({ key }) => key).join(', ')} });`
        );
    }
    if (catalogs !== 1) return fail(file, `declares ${catalogs} catalogs with defineErrors; it needs exactly one`);

    const imported = importsOf(file, bindings, used);

    const relative = file.split(path.sep).join('/');
    return [
        `${GENERATED_HEADER} from packages/errors/catalog/${relative}.`,
        '// Do not edit it: change the catalog and run `pnpm --filter @jsprismarine/errors run generate`.',
        '',
        imported,
        '',
        body.join('\n\n'),
        ''
    ].join('\n');
};

/** Every catalog file, by its path under `packages/errors/catalog/`. */
const catalogFiles = () =>
    readdirSync(CATALOG_DIR, { recursive: true, encoding: 'utf8' })
        .filter((file) => file.endsWith('.ts') && path.basename(file, '.ts') !== DEFINE_ERRORS_MODULE)
        .sort();

/** Every generated module, formatted, by its path under `packages/errors/src/`. */
export const generateAll = async (): Promise<Map<string, string>> => {
    const generated = new Map<string, string>();
    for (const file of catalogFiles()) {
        const target = path.join(OUTPUT_DIR, file);
        const options = (await prettier.resolveConfig(target)) ?? {};
        const module = generateCatalogModule(file, readFileSync(path.join(CATALOG_DIR, file), 'utf8'));
        generated.set(file, await prettier.format(module, { ...options, filepath: target }));
    }
    return generated;
};

/**
 * The modules under `src/` that a catalog generates, or once did: the ones that start with the
 * generator's header. A file written by hand lacks it, so the generator never deletes one.
 */
export const generatedOutputs = (directory = OUTPUT_DIR) =>
    readdirSync(directory, { recursive: true, encoding: 'utf8' }).filter(
        (file) => file.endsWith('.ts') && readFileSync(path.join(directory, file), 'utf8').startsWith(GENERATED_HEADER)
    );

if (import.meta.main) {
    const generated = await generateAll();
    const stale = [
        ...[...generated].filter(([file, contents]) => {
            const target = path.join(OUTPUT_DIR, file);
            return !existsSync(target) || readFileSync(target, 'utf8') !== contents;
        }),
        ...generatedOutputs()
            .filter((file) => !generated.has(file))
            .map((file) => [file, undefined] as const)
    ];

    if (process.argv.includes('--check')) {
        if (stale.length > 0) {
            for (const [file] of stale) console.error(`packages/errors/src/${file} does not match its catalog.`);
            console.error(
                '\nThe error classes are generated from packages/errors/catalog/. Edit the catalog, then run `pnpm --filter @jsprismarine/errors run generate`.'
            );
            process.exit(1);
        }
        console.log(`The error classes match their ${generated.size} catalogs.`);
    } else {
        for (const [file, contents] of stale) {
            const target = path.join(OUTPUT_DIR, file);
            if (contents === undefined) rmSync(target);
            else {
                mkdirSync(path.dirname(target), { recursive: true });
                writeFileSync(target, contents);
            }
        }
        console.log(`Wrote ${stale.length} of ${generated.size} error class modules.`);
    }
}
