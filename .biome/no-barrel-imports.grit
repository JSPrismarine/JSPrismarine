language js

// Value imports from a package's own barrel (`.`, `..`, `../..`, with or without `/index`)
// pull the whole package into a module that is still initializing, which is how runtime
// import cycles and TDZ errors start. Type-only imports are erased and stay allowed.
`import $imports from $source` as $statement where {
    $source <: r"^['\"](?:\.{1,2}(?:/\.\.)*/?(?:index)?)['\"]$",
    not $statement <: `import type $_ from $_`,
    register_diagnostic(
        span = $source,
        message = "Import the concrete module rather than a barrel: value imports from an index create runtime import cycles. `import type` is fine."
    )
}
