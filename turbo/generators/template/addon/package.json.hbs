{
    "name": "@jsprismarine/addon-{{ name }}",
    "private": true,
    "license": "(MIT OR MPL-2.0)",
    "description": "The {{ name }} addon's scripts, built from TypeScript",
    "type": "module",
    "scripts": {
        "build": "tsc-ts -p tsconfig.json",
        "clean": "rimraf scripts",
        "typecheck": "tsc-ts --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@jsprismarine/script-types": "workspace:*",
        "@minecraft/server": "{{ scriptApiVersion }}",
        "rimraf": "{{ rimrafVersion }}",
        "tsc-ts": "{{ tscTsVersion }}"
    }
}
