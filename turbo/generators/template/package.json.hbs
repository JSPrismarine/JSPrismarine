{
    "name": "@jsprismarine/{{ dashCase name }}",
    "version": "{{ version }}",
    "description": "{{ description }}",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "main": "./dist/index.cjs.cjs",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "typecheck": "tsc-ts --noEmit"
    },
    "devDependencies": {
        "@types/node": "{{lookup pkg.devDependencies '@types/node'}}",
        "glob": "{{ pkg.devDependencies.glob }}",
        "rimraf": "{{ pkg.devDependencies.rimraf }}",
        "typescript": "{{ pkg.devDependencies.typescript }}",
        "vite": "{{ pkg.devDependencies.vite }}",
        "vitest": "{{ pkg.devDependencies.vitest }}"
    },
    "dependencies": {},
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.es.js",
                "module": "./dist/index.es.js",
                "require": "./dist/index.cjs.cjs"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.es.js",
                "module": "./dist/*.es.js",
                "require": "./dist/*.cjs.cjs"
            },
            "./package.json": "./package.json"
        }
    }
}
