{
    "name": "jsprismarine",
    "version": "0.0.0",
    "description": "Dedicated Minecraft Bedrock Edition server written in TypeScript",
    "prettier": "@nordcom/prettier",
    "sideEffects": false,
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.18.0",
    "engines": {
        "node": ">=26.4.0",
        "pnpm": ">=12"
    },
    "scripts": {
        "preinstall": "node scripts/ensure-pnpm.mts",
        "prepare": "node scripts/share-worktree-cache.ts && pnpm --filter @jsprismarine/bedrock-data run generate && (husky || true)",
        "start": "pnpm --filter ./packages/server run start",
        "dev": "pnpm --filter ./packages/server run dev",
        "bringup": "pnpm --filter @jsprismarine/bedrock-data run bringup",
        "e2e:client": "c8 pnpm --filter @jsprismarine/client-e2e run e2e",
        "e2e:client:dist": "cross-env JSP_E2E_SERVER_ENTRY=dist c8 pnpm --filter @jsprismarine/client-e2e run e2e",
        "fetch:java-server": "node packages/bedrock-data/utils/java/fetch-server.ts",
        "clean": "turbo run clean",
        "build": "turbo run build --env-mode=loose",
        "build:docs": "pnpm --filter @jsprismarine/docs run docs",
        "check:docs": "pnpm --filter @jsprismarine/docs run docs:check",
        "docs:facts": "pnpm --filter @jsprismarine/docs run docs:facts",
        "dev:docs": "pnpm --filter @jsprismarine/docs run docs:dev",
        "build:watch": "turbo run build:watch --concurrency 32",
        "server:build": "turbo run build --filter=@jsprismarine/server --env-mode=loose",
        "test:dist-contract": "node scripts/check-workspace-conditions.mjs && pnpm --filter @jsprismarine/protocol run test:dist-contract",
        "test": "pnpm --filter @jsprismarine/bedrock-data run ensure:java-server && vitest run --coverage",
        "test:json-assets": "node scripts/json-assets.mjs check",
        "bench:json-assets": "node --expose-gc scripts/json-assets.mjs bench",
        "bench:content-snapshot": "node scripts/content-snapshot-benchmark.mts",
        "typecheck": "turbo run typecheck && tsc-ts -p tsconfig.scripts.json",
        "lint": "concurrently --prefix '{name}' pnpm:lint:prettier pnpm:lint:biome pnpm:lint:custom",
        "lint:all": "cross-env JSP_LINT_ALL=1 pnpm run lint",
        "lint:prettier": "node scripts/lint-changed.mts prettier --check",
        "format": "concurrently --prefix '{name}' pnpm:format:prettier pnpm:format:biome",
        "format:all": "cross-env JSP_LINT_ALL=1 pnpm run format",
        "format:prettier": "node scripts/lint-changed.mts prettier --write",
        "package": "node scripts/package-sea.mts",
        "version": "changeset version",
        "postversion": "pnpm install",
        "version:unstable": "changeset version --snapshot unstable",
        "release": "changeset publish",
        "release:unstable": "changeset publish --no-git-tag --tag unstable",
        "changeset": "changeset",
        "lint:american-filenames": "node scripts/check-american-filenames.mts",
        "lint:custom": "concurrently --prefix '{name}' pnpm:lint:american-filenames pnpm:lint:barrels pnpm:lint:packets pnpm:lint:wire-layouts pnpm:lint:jsdoc pnpm:lint:encoding pnpm:lint:docs-facts",
        "lint:barrels": "node scripts/check-barrels.mts",
        "lint:packets": "node scripts/check-packet-codecs.mts",
        "lint:wire-layouts": "node scripts/check-wire-layouts.mts",
        "lint:biome": "node scripts/lint-changed.mts biome check",
        "format:biome": "node scripts/lint-changed.mts biome lint --write",
        "package:scriptc": "scriptc build ./packages/server/src/Server.ts --npm-static auto --out ./dist/prismarine-scriptc",
        "package:scriptc:coverage": "scriptc coverage ./packages/server/src/Server.ts",
        "lint:jsdoc": "node scripts/check-jsdoc.mts",
        "lint:encoding": "node scripts/check-unicode-escapes.mts",
        "lint:docs-facts": "pnpm --filter @jsprismarine/docs run check:facts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "javascript",
        "typescript",
        "minecraft",
        "mcpe",
        "bedrock",
        "be"
    ],
    "author": "JSPrismarine",
    "contributors": [
        {
            "name": "Filiph Sandström",
            "email": "filiph@hotmail.se",
            "url": "https://github.com/filiphsps"
        },
        {
            "name": "Enrico Angelon",
            "email": "enricoangelon.ea@gmail.com",
            "url": "https://enricoangelon.it/"
        }
    ],
    "license": "MPL-2.0",
    "bugs": {
        "url": "https://github.com/JSPrismarine/JSPrismarine/issues"
    },
    "homepage": "https://jsprismarine.github.io/JSPrismarine/",
    "devDependencies": {
        "@biomejs/biome": "2.6.6",
        "@changesets/changelog-github": "1.0.1",
        "@changesets/cli": "3.0.3",
        "@changesets/types": "7.0.0",
        "@codecov/vite-plugin": "2.0.1",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@commitlint/types": "21.2.3",
        "@nordcom/prettier": "0.1.1",
        "@scriptc/threads": "0.4.10",
        "@turbo/gen": "2.11.10",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "5.1.0",
        "c8": "12.0.0",
        "concurrently": "10.0.7",
        "cross-env": "10.1.0",
        "glob": "14.0.4",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "prettier": "3.9.10",
        "rolldown": "1.3.1",
        "scriptc": "0.4.10",
        "ts-mockito": "2.6.1",
        "tsc-ts": "0.1.3",
        "turbo": "2.11.10",
        "turbo-ignore": "2.11.10",
        "typescript": "7.0.2",
        "vite": "8.3.7",
        "vitest": "5.1.0"
    },
    "dependencies": {
        "@jsprismarine/bedrock-data": "workspace:*",
        "@jsprismarine/binaryutils": "workspace:*",
        "@jsprismarine/brigadier": "workspace:*",
        "@jsprismarine/minecraft": "workspace:*"
    }
}
