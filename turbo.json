{
    "$schema": "https://turborepo.org/schema.json",
    "ui": "stream",
    "globalDependencies": ["tsconfig.json", "tsconfig.build.json", "package.json", "vite.config.ts", ".env"],
    "globalPassThroughEnv": [
        "GITHUB_ACTIONS",
        "GITHUB_ENV",
        "JSP_LINT_ALL",
        "JSP_LINT_BASE",
        "JSP_SHARED_CACHE",
        "npm_config_user_agent",
        "VITEST_SHARD"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["**/dist/**", "**/docs/**", "**/src/generated/**", "!*/**/coverage/**"]
        },
        "build:watch": {
            "cache": false,
            "persistent": true
        },
        "clean": {
            "cache": false
        },
        "fetch:sources": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "inputs": ["$TURBO_DEFAULT$", ".env.development.local", ".env.local", ".env.development", ".env"]
        },
        "typecheck": {
            "cache": false
        }
    }
}
