{
    "$schema": "https://turborepo.org/schema.json",
    "ui": "stream",
    "globalDependencies": [
        "tsconfig.json",
        "tsconfig.build.json",
        "package.json",
        "vite.config.ts",
        ".env",
        "scripts/emit-dts.mts",
        "scripts/declaration-specifiers.mts"
    ],
    "globalPassThroughEnv": [
        "GITHUB_ACTIONS",
        "GITHUB_ENV",
        "GITHUB_REPOSITORY",
        "JSP_LINT_ALL",
        "JSP_LINT_BASE",
        "JSP_SHARED_CACHE",
        "npm_config_user_agent",
        "UPDATE_FEED_SIGNING_KEY",
        "VITEST_SHARD"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "env": ["CI"],
            "outputs": ["**/dist/**", "**/docs/**", "**/src/generated/**", "!*/**/coverage/**"]
        },
        "build:watch": {
            "cache": false,
            "persistent": true
        },
        "clean": {
            "cache": false
        },
        "fetch:sources": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "inputs": ["$TURBO_DEFAULT$", ".env.development.local", ".env.local", ".env.development", ".env"]
        },
        "typecheck": {
            "cache": false
        }
    }
}
